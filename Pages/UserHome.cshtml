@page "/UserHome"
@model Dr.meow.Pages.UserHomeModel

@{
    ViewData["Title"] = "使用者顧問中心";
}

<div class="row g-3">
    <!-- 左側選單 -->
    <aside class="col-12 col-lg-3">
        <div class="card shadow-sm">
            <div class="list-group list-group-flush app-sidebar">
                <div class="list-group-item text-secondary small text-uppercase">
                    功能
                    <span class="float-end text-muted small">
                        @Model.Account（使用者）
                    </span>
                </div>

                <!-- RAG 顧問：預設 mode=consult -->
                <a class="list-group-item list-group-item-action app-menu active"
                   data-mode="consult">
                    RAG 顧問
                </a>

                <!-- 新增表單：照舊直接跳頁 -->
                <a class="list-group-item list-group-item-action"
                   asp-page="/Vulnerabilities/Create">
                    新增表單
                </a>

                <!-- 查看表單：同頁切換、Ajax 載入 -->
                <a class="list-group-item list-group-item-action app-menu"
                   data-mode="forms">
                    查看表單
                </a>

                <div class="list-group-item text-secondary small text-uppercase">問答歷史</div>

                <a class="list-group-item list-group-item-action text-danger" asp-page="/Login">
                    登出
                </a>
            </div>
        </div>
    </aside>

    <!-- 右側主區 -->
    <section class="col-12 col-lg-9">
        <div class="card shadow-sm">
            <div class="card-header bg-white">
                <h5 class="mb-0">Dr.Meow 使用者顧問中心</h5>
            </div>
            <div class="card-body">
                <div id="noteBox" class="alert alert-info py-2">
                    您目前以「使用者」登入，可向 RAG 顧問提問，並填寫變更／漏洞表單。
                </div>
                <!-- RAG 顧問區塊：預設顯示 -->
                <div id="ragArea">
                    <div id="messages" class="chat-stream mb-3"></div>
                    <div id="summaryBox" class="alert alert-secondary d-none"></div>
                    <div id="results" class="row row-cols-1 row-cols-md-2 g-3 mt-1"></div>

                    <form id="askForm" class="row g-2 mt-2">
                        <div class="col">
                            <input id="askInput" class="form-control"
                                   placeholder="輸入問題，例如：最近漏洞通報與處置建議？" autocomplete="off" />
                        </div>
                        <div class="col-auto d-flex gap-2">
                            <button id="btnVoice" class="btn btn-outline-secondary" type="button">🔍 語音</button>
                            <button class="btn btn-primary" type="submit">送出</button>
                            <button id="btnClear" class="btn btn-outline-secondary" type="button">清空</button>
                        </div>
                    </form>
                </div>
                <!-- 查看表單區塊：一開始隱藏，點「查看表單」才顯示 -->
                <div id="formsArea" class="d-none">
                    <div id="formsContainer">
                        <!-- 第一次切換時由 JS 透過 Ajax 載入 FormsList 的 HTML -->
                        載入中…
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>
<div class="offcanvas offcanvas-end meow-offcanvas" tabindex="-1" id="offcanvasSource">
    <div class="offcanvas-header">
        <h5 class="offcanvas-title" id="offcanvasSourceLabel">📄 原始文件內容</h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button>
    </div>

    <div class="offcanvas-body">
        <h6 id="sourceTitle" class="fw-bold mb-3"></h6>

        <!-- ⭐ 玻璃內容區 -->
        <div id="sourceContent" class="meow-source-box">
        </div>

        <div class="rag-footer">
            來源：RAG 知識庫
        </div>

    </div>
</div>


@section Scripts {
    <script>
            let globalSourceMap = {};   // <-- 全域來源索引庫
                const messageSources = {};   // key: messageId → value: sources array


        // ✅ TODO：把這個改成你實際的 FormsList Partial View 路徑
        // 例如 Razor Page: /Vulnerabilities/FormsList?handler=Partial
        const FORMS_URL = '/Forms/FormsList';
        // === 設定：真正打到 Razor Page 的 API ===
        const API_URL = '/Api/Search';

    /* 抓 DOM */
        const menuItems = document.querySelectorAll('.app-menu');
        const topics    = document.querySelectorAll('.app-topic');
        const noteBox   = document.getElementById('noteBox');

        const ragArea   = document.getElementById('ragArea');
        const formsArea = document.getElementById('formsArea');
        const formsContainer = document.getElementById('formsContainer');

        const msgs      = document.getElementById('messages');
        const results   = document.getElementById('results');
        const summary   = document.getElementById('summaryBox');
        const form      = document.getElementById('askForm');
        const input     = document.getElementById('askInput');
        const btnClear  = document.getElementById('btnClear');
        const btnVoice  = document.getElementById('btnVoice');

        let formsLoaded = false;
        let currentSources = [];

        // 側邊欄實體
        const sourceOffcanvas = new bootstrap.Offcanvas(document.getElementById('offcanvasSource'));

        /* 左側點選高亮 + 模式切換 */
        menuItems.forEach(it => {
            it.addEventListener('click', () => {
                menuItems.forEach(x => x.classList.remove('active'));
                it.classList.add('active');

                const mode = it.dataset.mode;
                if (!mode) return;

                if (mode === 'consult') {
                    // 顧問模式：顯示 RAG，隱藏表單
                    ragArea.classList.remove('d-none');
                    formsArea.classList.add('d-none');
                    noteBox.textContent = '您目前在「RAG 顧問」模式，可向系統提問相關問題。';

                    // 顧問區切換時順便清一下畫面
                    msgs.innerHTML = '';
                    results.innerHTML = '';
                    summary.classList.add('d-none');
                }
                else if (mode === 'forms') {
                    // 查看表單模式：顯示表單列表，隱藏 RAG
                    ragArea.classList.add('d-none');
                    formsArea.classList.remove('d-none');
                    noteBox.textContent = '您目前在「查看表單」模式，可瀏覽已填寫的變更／漏洞表單。';

                    if (!formsLoaded) {
                        loadFormsList();
                    }
                }
            });
        });

        /* 第一次進入「查看表單」時，Ajax 抓 FormsList HTML 塞進來 */
        async function loadFormsList() {
            formsContainer.textContent = '載入中…';
            try {
                const resp = await fetch(FORMS_URL, { method: 'GET' });
                if (!resp.ok) {
                    const txt = await resp.text();
                    formsContainer.innerHTML = `載入失敗（${resp.status}）：${escapeHtml(txt)}`;
                    return;
                }
                const html = await resp.text();
                formsContainer.innerHTML = html;
                formsLoaded = true;
            } catch (err) {
                console.error(err);
                formsContainer.textContent = '載入失敗，請稍後再試。';
            }
        }

        /* 主題快捷鍵 */
        topics.forEach(tp => {
            tp.addEventListener('click', () => {
                input.value = `請提供「${tp.dataset.prompt}」的作業重點與處置流程`;
                input.focus();
            });
        });

        /* 送出：顯示泡泡 + 呼叫 /Api/Search 拿真實資料 */
        form.addEventListener('submit', async (e) => {
            e.preventDefault();
            const q = input.value.trim();
            if (!q) return;

            // 顯示使用者提問
            pushUser(q);
            input.value = '';

            // 顯示「查詢中」泡泡 (並取得 ID 方便移除)
            const loadingId = pushBot('查詢中，請稍候…', true);

            try {
            const resp = await fetch(API_URL, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                // 如果有開 CSRF 防護，這裡可能要加 RequestVerificationToken，但在 API 模式下通常不需要
            },
            body: JSON.stringify({ query: q }) // 屬性名稱要對應後端的 RagQueryRequest
        });
                if (!resp.ok) {
                    const text = await resp.text();
                    replaceBotMessage(loadingId, `後端發生錯誤（${resp.status}）：${text}`);
                    return;
                }

                const data = await resp.json(); // { answer: "...", items: [...] }
                console.log("收到後端資料:", data);
                const sources = data.items || data.sources || data.Sources || [];

                /** 🧠 儲存「這一題」的所有文件 */
                messageSources[loadingId] = sources;

                /** 🧠 建立全域文件索引（不覆蓋舊的） */
                sources.forEach(s => {
                const key = s.title || s.fileName;
                    if (key && !globalSourceMap[key]) {
                        globalSourceMap[key] = s;
                    }
                });
                // 📝 處理回答文字 → 把 [來源: xxx] 轉成可點擊連結，綁定這一題的 msgId
                const rawAnswer = data.answer || data.Answer || '（沒有取得 AI 回覆）';
                const formattedAnswer = formatText(rawAnswer, loadingId);

                // 更新機器人訊息
                replaceBotMessage(loadingId, formattedAnswer);

                // 上方 summary 區 (可選，這裡先隱藏以免重複)
                // summary.classList.remove('d-none');
                // summary.innerHTML = processedAnswer;

                // 下方文件卡片 (總覽用)
                results.innerHTML = '';
                sources.forEach(x => addResultCard(x, loadingId));

                scrollBottom();

            } catch (err) {
                console.error(err);
                replaceBotMessage(loadingId, '查詢失敗，請檢查後端連線或稍後再試。');
            }
        });

        /* 清空 */
        // btnClear.addEventListener('click', () => {
        //     msgs.innerHTML = '';
        //     results.innerHTML = '';
        //     summary.classList.add('d-none');
        // });
        /* 清空按鈕：只清輸入框 */
        btnClear.addEventListener('click', (e) => {
            e.preventDefault();
            input.value = '';
        });

        /* === 🔥 核心格式化工具 (Markdown + 引用連結) === */
        function formatText(text, msgId) {
            if (!text) return '';

            // 1. 先做基本的 HTML 跳脫 (防止 XSS，但保留我們後面要加的標籤)
            // 我們先不跳脫，而是用取代的方式處理特殊字元，或者手動處理
            // 這裡簡單實作：先 escape，再還原 Markdown 語法
            let safeText = escapeHtml(text);

            // 2. 處理 **粗體** -> <strong>粗體</strong>
            // Regex: \*\*(.*?)\*\*
            safeText = safeText.replace(/\*\*(.*?)\*\*/g, '<strong class="text-dark">$1</strong>');

            // 3. 處理條列點 (例如 "- 項目") -> 加上換行或縮排 (選用)
            // 這裡簡單將換行符號 \n 轉為 <br>
            safeText = safeText.replace(/\n/g, '<br>');

            // 4. [來源: xxx] / [cite: xxx] -> 可點擊的 a 標籤
            safeText = safeText.replace(/\[(來源|cite):\s*(.*?)\]/gi, (match, _label, fileName) => {
                const name = (fileName || '').trim();
                const safeNameForJs = escapeJs(name);        // 放進 onclick
                const safeMatchText = escapeHtml(match);     // 顯示給使用者看的字

                return `<a href="javascript:void(0)" class="citation-link text-decoration-none fw-bold" onclick="showSource('${safeNameForJs}', '${msgId}')">📄 ${safeMatchText}</a>`;
            });

            return safeText;
        }

        /* === 核心功能：顯示側邊欄 === */
        /* === 核心功能：顯示側邊欄（支援多文件下拉 + 頁面切換） === */
        window.showSource = function (fileName, msgId) {
            // 這一題的所有文件
            const sourceList = messageSources[msgId] || [];

            if (!sourceList.length && !fileName) {
                alert('這一題沒有可用的文件來源');
                return;
            }

            // 根據 fileName 找出要先顯示哪一份文件
            let activeIndex = 0;
            if (fileName) {
                const idx = sourceList.findIndex(s =>
                    (s.title && s.title.includes(fileName)) ||
                    (s.fileName && s.fileName.includes(fileName))
                );
                if (idx >= 0) activeIndex = idx;
            }

            // 若這一題裡沒找到，但有全域索引，就單獨顯示那份
            let currentDoc = sourceList[activeIndex];
            if (!currentDoc && fileName) {
                currentDoc = globalSourceMap[fileName];
            }

            if (!currentDoc) {
                alert(`找不到文件來源：${fileName || '（未指定）'}`);
                return;
            }

            const titleEl = document.getElementById("sourceTitle");
            const container = document.getElementById("sourceContent");

            let currentPageIndex = 0;

            function renderPage() {
                const pages = currentDoc.pages || [];
                const contents = currentDoc.pageContents || {};

                const pageKey = pages.length ? pages[currentPageIndex] : null;
                const text = pageKey ? (contents[pageKey] || "(沒有內容)") : "(沒有內容)";

                const docTitle = currentDoc.title || currentDoc.fileName || '未命名文件';
                const totalPages = pages.length || 1;

                // 標題顯示：文件名 + 頁數
                titleEl.textContent = `${docTitle}（${totalPages} 頁）`;

                const hasMultipleDocs = sourceList.length > 1;

                // 上方文件下拉選單（同一題有多個文件時才出現）
                let docSelectorHtml = '';
                if (hasMultipleDocs) {
                    const optionsHtml = sourceList.map((s, i) => {
                        const label = s.title || s.fileName || `文件 ${i + 1}`;
                        const selected = i === activeIndex ? 'selected' : '';
                        return `<option value="${i}" ${selected}>${escapeHtml(label)}</option>`;
                    }).join('');

                    docSelectorHtml = `
                        <div class="mb-2">
                            <select class="form-select form-select-sm" id="meowDocSelect">
                                ${optionsHtml}
                            </select>
                        </div>
                    `;
                }

                // 頁碼切換控制列
                const controlsHtml = `
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <button class="meow-page-btn" id="btnPrevPage" ${currentPageIndex === 0 ? "disabled" : ""}>
                            ‹
                        </button>

                        <span class="meow-page-info">
                            第 ${currentPageIndex + 1} / ${totalPages} 頁
                        </span>

                        <button class="meow-page-btn" id="btnNextPage" ${currentPageIndex >= totalPages - 1 ? "disabled" : ""}>
                            ›
                        </button>
                    </div>
                `;

                // 寫入內容
                container.innerHTML = `
                    ${docSelectorHtml}
                    ${controlsHtml}
                    <div class="p-3 bg-light border rounded font-monospace small"
                         style="white-space: pre-wrap; line-height: 1.6;">
                        ${escapeHtml(text)}
                    </div>
                `;

                // 綁定文件選擇下拉
                if (hasMultipleDocs) {
                    const sel = document.getElementById('meowDocSelect');
                    if (sel) {
                        sel.addEventListener('change', (e) => {
                            const idx = parseInt(e.target.value, 10);
                            if (!isNaN(idx) && sourceList[idx]) {
                                activeIndex = idx;
                                currentDoc = sourceList[activeIndex];
                                currentPageIndex = 0;   // 切文件時回到第一頁
                                renderPage();
                            }
                        });
                    }
                }

                // 綁定頁面切換按鈕
                const prevBtn = document.getElementById("btnPrevPage");
                const nextBtn = document.getElementById("btnNextPage");

                prevBtn && prevBtn.addEventListener("click", () => {
                    if (currentPageIndex > 0) {
                        currentPageIndex--;
                        renderPage();
                    }
                });

                nextBtn && nextBtn.addEventListener("click", () => {
                    if (currentPageIndex < totalPages - 1) {
                        currentPageIndex++;
                        renderPage();
                    }
                });
            }

            // 初始化顯示
            renderPage();
            sourceOffcanvas.show();
        };



        /* === 泡泡工具 (維持你想要的樣式) === */
        function pushUser(t) {
            msgs.insertAdjacentHTML('beforeend', `
            <div class="msg-row msg-user-row">
                <div class="msg msg-user">${escapeHtml(t)}</div>
            </div>`);
            scrollBottom();
        }

        // 修正後的 pushBot (必須回傳 ID)
        function pushBot(htmlContent, isLoading = false) {
            const id = 'msg-' + Date.now();
            // 如果是 loading，加上轉圈圈
            const content = isLoading ?
                `<span class="text-secondary"><span class="spinner-border spinner-border-sm me-2"></span>${htmlContent}</span>` :
                htmlContent;

            msgs.insertAdjacentHTML('beforeend', `
            <div class="msg-row msg-bot-row" id="${id}">
                <div class="msg msg-bot">${content}</div>
            </div>`);

            scrollBottom();

            return id; // ✅ 關鍵！一定要回傳 ID
        }

        // 更新指定的泡泡內容
        function replaceBotMessage(id, htmlContent) {
            const el = document.getElementById(id);
            if (el) {
                // const bubble = el.querySelector('.msg-bot');
                // if (bubble) {
                //     bubble.innerHTML = htmlContent;
                // }
                el.innerHTML = `
            <div class="msg msg-bot">${htmlContent}</div>
        `;
        scrollBottom();
            }
        }

        function scrollBottom() {
            msgs.scrollTop = msgs.scrollHeight;
        }

        // 用於 HTML 內容轉義 (防 XSS)
        function escapeHtml(s) {
            return (s || '').replace(/[&<>"']/g, m => ({
                '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
            }[m]));
        }

        // 用於 JS 字串轉義 (防引號破壞 onclick)
        function escapeJs(s) {
            return (s || '').replace(/'/g, "\\'");
        }

                /* 文件卡片：每一題自己的來源清單 */
        function addResultCard(x, msgId) {
            const title = x.title || x.fileName || '（無標題）';

            results.insertAdjacentHTML('beforeend', `
                <div class="col">
                    <div class="card result-card h-100 shadow-sm border-0">
                        <div class="card-body d-flex flex-column">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <h6 class="card-title mb-0 text-truncate">
                                    <a href="javascript:void(0)"
                                       class="text-decoration-none"
                                       onclick="showSource('${escapeJs(title)}', '${msgId}')">
                                        📄 ${escapeHtml(title)}
                                    </a>
                                </h6>
                                <span class="badge bg-light text-dark border">
                                    Score: ${escapeHtml(x.source || 'RAG')}
                                </span>
                            </div>
                            <div class="text-muted small mb-2 text-truncate">
                                ${escapeHtml(x.snippet || '')}
                            </div>
                            <div class="d-flex gap-2 mt-auto">
                                <button class="btn btn-outline-primary btn-sm w-100"
                                        onclick="showSource('${escapeJs(title)}', '${msgId}')">
                                    查看內文
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            `);
        }


        /* 語音：Web Speech API (維持原樣) */
        (function () {
            const SR = window.SpeechRecognition || window.webkitSpeechRecognition;
            if (!SR) return;
            const recog = new SR();
            recog.lang = 'zh-TW';
            recog.continuous = false;
            recog.interimResults = true;

            let listening = false;
            btnVoice.addEventListener('click', () => { listening ? stop() : start(); });
            function start() { try { recog.start(); listening = true; btnVoice.textContent = '🎙️ 辨識中…'; } catch (e) { } }
            function stop() { try { recog.stop(); listening = false; btnVoice.textContent = '🔍 語音'; } catch (e) { } }

            recog.onresult = (e) => {
                let final = '', interim = '';
                for (let i = e.resultIndex; i < e.results.length; i++) {
                    const text = e.results[i][0].transcript;
                    if (e.results[i].isFinal) final += text;
                    else interim += text;
                }
                input.value = (final || interim).trim();
            };
            recog.onend = () => { listening = false; btnVoice.textContent = '🔍 語音'; };
        })();

    </script>
}