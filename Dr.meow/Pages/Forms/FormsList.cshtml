@page
@model Dr.meow.Pages.Forms.FormsListModel
@{
    ViewData["Title"] = "卡片式變更/漏洞清單";
    Layout = null;
}

<style>
    /* 卡片整體風格 */
    .custom-card {
        border: 1px solid #e0e0e0;
        border-radius: 8px;
        box-shadow: 0 2px 5px rgba(0,0,0,0.05);
        background: #fff;
        padding: 20px;
        margin-bottom: 15px;
        transition: transform 0.2s;
    }

        .custom-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
        }

    .card-header-custom {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 12px;
    }

    .ticket-id {
        font-weight: 700;
        color: #333;
        font-size: 1.1rem;
    }

    .assigned-to {
        font-size: 0.9rem;
        color: #666;
        margin-top: 5px;
        display: block;
    }

    /* 標籤群組 */
    .badge-group {
        display: flex;
        gap: 5px;
        flex-wrap: wrap;
        justify-content: flex-end;
    }

    /* 系統類別標籤 (藍色系) */
    .badge-system {
        color: #0d6efd;
        border: 1px solid #0d6efd;
        padding: 2px 8px;
        border-radius: 4px;
        font-size: 0.85rem;
        font-weight: 600;
        background-color: #eaf3ff;
    }

    /* 工單類別標籤 (灰色系) */
    .badge-ticket-cat {
        color: #495057;
        border: 1px solid #ced4da;
        padding: 2px 8px;
        border-radius: 4px;
        font-size: 0.85rem;
        font-weight: 600;
        background-color: #f8f9fa;
    }

    /* 變更類型狀態標籤 */
    .badge-status {
        padding: 3px 10px;
        border-radius: 4px;
        font-size: 0.85rem;
        font-weight: 500;
        display: inline-block;
    }

    /* 狀態顏色邏輯 */
    .status-pending {
        background-color: #fff3cd;
        color: #856404;
        border: 1px solid #ffeeba;
    }
    /* 預設/審核中 */
    .status-approved {
        background-color: #d1e7dd;
        color: #0f5132;
        border: 1px solid #badbcc;
    }
    /* 標準/例行 */
    .status-rejected {
        background-color: #f8d7da;
        color: #842029;
        border: 1px solid #f5c2c7;
    }
    /* 緊急 */

    .summary-text {
        color: #555;
        font-size: 1rem;
        margin-bottom: 15px;
        line-height: 1.5;
        border-left: 3px solid #0d6efd;
        padding-left: 10px;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .meta-info {
        font-size: 0.9rem;
        color: #666;
        background-color: #f9f9f9;
        padding: 10px;
        border-radius: 6px;
        display: flex;
        flex-wrap: wrap;
        gap: 15px;
        align-items: center;
        margin-top: 15px;
    }

    .meta-item {
        display: flex;
        align-items: center;
        gap: 5px;
    }

    .meta-label {
        font-weight: 600;
        color: #333;
    }

    /* 風險標籤樣式 */
    .badge-risk {
        padding: 2px 8px;
        border-radius: 4px;
        font-size: 0.85rem;
        font-weight: 600;
    }

    .risk-low {
        background-color: #d1e7dd;
        color: #0f5132;
    }

    .risk-medium {
        background-color: #fff3cd;
        color: #856404;
    }

    .risk-high {
        background-color: #f8d7da;
        color: #842029;
    }

    .risk-critical {
        background-color: #dc3545;
        color: #fff;
    }

    .view-btn {
        display: block;
        text-align: right;
        margin-top: 10px;
        color: #0d6efd;
        text-decoration: none;
        font-weight: 500;
    }

        .view-btn:hover {
            text-decoration: underline;
        }
</style>

<div class="container-fluid pt-3">
    @if (Model.VulnerabilityList != null && Model.VulnerabilityList.Any())
    {
        @foreach (var item in Model.VulnerabilityList)
        {
            // --- 邏輯判斷區 ---

            // 1. 風險顏色判斷 (根據 Severity)
            string riskClass = "risk-low";
            if (item.Severity?.Contains("中") == true) { riskClass = "risk-medium"; }
            else if (item.Severity?.Contains("高") == true) { riskClass = "risk-high"; }
            else if (item.Severity?.Contains("重大") == true) { riskClass = "risk-critical"; }

            // 2. 變更類型顏色判斷 (根據 ChangeType)
            string statusText = item.ChangeType ?? "未分類";
            string statusClass = "status-pending";

            if (statusText.Contains("緊急")) { statusClass = "status-rejected"; }
            else if (statusText.Contains("例行") || statusText.Contains("標準")) { statusClass = "status-approved"; }

            <div class="custom-card">
                <div class="card-header-custom">
                    <div class="d-flex flex-column">
                        <span class="ticket-id">
                            @(string.IsNullOrEmpty(item.TicketNumber) ? $"表單 #{item.Id}" : item.TicketNumber)
                        </span>

                        <span class="assigned-to">
                            <i class="bi bi-person-circle"></i> 指派給：@(item.AssignedTo ?? "未指派")
                        </span>
                    </div>

                    <div class="badge-group text-end" style="max-width: 50%;">
                        @if (!string.IsNullOrEmpty(item.SystemCategory))
                        {
                            <span class="badge-system">@item.SystemCategory</span>
                        }

                        @if (!string.IsNullOrEmpty(item.TicketCategory))
                        {
                            <span class="badge-ticket-cat">@item.TicketCategory</span>
                        }
                    </div>
                </div>

                <div class="summary-text">
                    <strong>變更摘要：</strong> @item.Description
                </div>

                <div class="meta-info">
                    <div class="meta-item">
                        <span class="meta-label">🏷️ 類型：</span>
                        <span class="badge-status @statusClass">@statusText</span>
                    </div>

                    <div class="meta-item">
                        <span class="meta-label">📅 預計實施：</span>
                        <span>@item.FoundDate.ToString("yyyy/MM/dd") @(item.ScheduledTime ?? "")</span>
                    </div>

                    <div class="meta-item">
                        <span class="meta-label">🛡️ 風險：</span>
                        <span class="badge-risk @riskClass">@(item.Severity ?? "未評估")</span>
                    </div>

                    @if (!string.IsNullOrEmpty(item.ImpactLevel))
                    {
                        <div class="meta-item">
                            <span class="meta-label">💥 影響：</span>
                            <span>@item.ImpactLevel</span>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(item.Dependency))
                    {
                        <div class="meta-item">
                            <span class="meta-label">🔗 依賴：</span>
                            <span>@item.Dependency</span>
                        </div>
                    }
                </div>

                <div class="text-end pt-2">
                    <a asp-page="/Vulnerabilities/Details" asp-route-id="@item.Id" class="btn btn-link view-btn">
                        查看完整內容 &gt;
                    </a>
                </div>
            </div>
        }
    }
    else
    {
        <div class="alert alert-info mt-4 text-center">
            <i class="bi bi-info-circle"></i> 目前沒有任何變更或漏洞紀錄。
        </div>
    }
</div>