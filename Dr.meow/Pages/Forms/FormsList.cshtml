@page
@model Dr.meow.Pages.Forms.FormsListModel
@{
    ViewData["Title"] = "卡片式變更/漏洞清單";
   
}

<style>
    /* 卡片整體風格 */
    .custom-card {
        border: 1px solid #e0e0e0;
        border-radius: 8px;
        box-shadow: 0 2px 5px rgba(0,0,0,0.05);
        background: #fff;
        padding: 20px;
        margin-bottom: 15px;
        transition: transform 0.2s;
    }

        .custom-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
        }

    .card-header-custom {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 12px;
    }

    .ticket-id {
        font-weight: 700;
        color: #333;
        font-size: 1.1rem;
    }

    .assigned-to {
        font-size: 0.9rem;
        color: #666;
        margin-top: 5px;
        display: block;
    }

    /* 標籤群組 */
    .badge-group {
        display: flex;
        gap: 5px;
        flex-wrap: wrap;
        justify-content: flex-end;
    }

    /* 系統類別標籤 (藍色系) */
    .badge-system {
        color: #0d6efd;
        border: 1px solid #0d6efd;
        padding: 2px 8px;
        border-radius: 4px;
        font-size: 0.85rem;
        font-weight: 600;
        background-color: #eaf3ff;
    }

    /* 工單類別標籤 (灰色系) */
    .badge-ticket-cat {
        color: #495057;
        border: 1px solid #ced4da;
        padding: 2px 8px;
        border-radius: 4px;
        font-size: 0.85rem;
        font-weight: 600;
        background-color: #f8f9fa;
    }

    /* 變更類型狀態標籤 */
    .badge-status {
        padding: 3px 10px;
        border-radius: 4px;
        font-size: 0.85rem;
        font-weight: 500;
        display: inline-block;
    }

    /* 狀態顏色邏輯 */
    .status-pending {
        background-color: #fff3cd;
        color: #856404;
        border: 1px solid #ffeeba;
    }
    /* 預設/審核中 */
    .status-approved {
        background-color: #d1e7dd;
        color: #0f5132;
        border: 1px solid #badbcc;
    }
    /* 標準/例行 */
    .status-rejected {
        background-color: #f8d7da;
        color: #842029;
        border: 1px solid #f5c2c7;
    }
    /* 緊急 */

    .summary-text {
        color: #555;
        font-size: 1rem;
        margin-bottom: 15px;
        line-height: 1.5;
        border-left: 3px solid #0d6efd;
        padding-left: 10px;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .meta-info {
        font-size: 0.9rem;
        color: #666;
        background-color: #f9f9f9;
        padding: 10px;
        border-radius: 6px;
        display: flex;
        flex-wrap: wrap;
        gap: 15px;
        align-items: center;
        margin-top: 15px;
    }

    .meta-item {
        display: flex;
        align-items: center;
        gap: 5px;
    }

    .meta-label {
        font-weight: 600;
        color: #333;
    }

    /* 風險標籤樣式 */
    .badge-risk {
        padding: 2px 8px;
        border-radius: 4px;
        font-size: 0.85rem;
        font-weight: 600;
    }

    .risk-low {
        background-color: #d1e7dd;
        color: #0f5132;
    }

    .risk-medium {
        background-color: #fff3cd;
        color: #856404;
    }

    .risk-high {
        background-color: #f8d7da;
        color: #842029;
    }

    .risk-critical {
        background-color: #dc3545;
        color: #fff;
    }

    .view-btn {
        display: block;
        text-align: right;
        margin-top: 10px;
        color: #0d6efd;
        text-decoration: none;
        font-weight: 500;
    }

    .view-btn:hover {
        text-decoration: underline;
    }

    /* --- 進度條 Stepper 樣式 --- */
    .status-stepper {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 10px 5px;
        margin: 15px 0;
        position: relative;
    }

    .step-item {
        display: flex;
        flex-direction: column;
        align-items: center;
        flex: 1;
        z-index: 2;
    }

    .step-dot {
        width: 12px;
        height: 12px;
        background-color: #e0e0e0;
        border-radius: 50%;
        margin-bottom: 6px;
        transition: all 0.4s ease;
        border: 2px solid #fff;
        box-shadow: 0 0 0 2px #eee;
    }

    .step-label {
        font-size: 0.7rem;
        color: #999;
        font-weight: 600;
    }

    .step-line {
        flex-grow: 1;
        height: 2px;
        background-color: #eee;
        margin-bottom: 22px; /* 這裡要微調對齊 Dot */
        z-index: 1;
    }

    /* 已完成：品牌綠色 */
    .step-active .step-dot {
        background-color: #3AB6A7;
        box-shadow: 0 0 0 2px #3AB6A7;
    }

    .step-active .step-label {
        color: #3AB6A7;
    }

    /* 處理中：呼吸燈動畫 */
    .step-processing .step-dot {
        background-color: #3AB6A7;
        animation: pulse-green 2s infinite;
    }

    .step-processing .step-label {
        color: #1f6e61;
        font-weight: bold;
    }

    /* 被退回：警告紅 */
    .step-rejected .step-dot {
        background-color: #dc3545;
        animation: pulse-red 1.5s infinite;
    }

    .step-rejected .step-label {
        color: #dc3545;
    }

    /* 動態線段顏色 */
    .line-active {
        background-color: #3AB6A7;
    }

    /* 動畫定義 */
    @@keyframes pulse-green {
        0% {
            box-shadow: 0 0 0 0 rgba(58, 182, 167, 0.7);
        }

        70% {
            box-shadow: 0 0 0 8px rgba(58, 182, 167, 0);
        }

        100% {
            box-shadow: 0 0 0 0 rgba(58, 182, 167, 0);
        }
    }

    @@keyframes pulse-red {
        0% {
            box-shadow: 0 0 0 0 rgba(220, 53, 69, 0.7);
        }

        70% {
            box-shadow: 0 0 0 8px rgba(220, 53, 69, 0);
        }

        100% {
            box-shadow: 0 0 0 0 rgba(220, 53, 69, 0);
        }
    }
    /* 進度條展開容器 */
    .collapse-stepper {
        max-height: 0;
        overflow: hidden;
        transition: max-height 0.3s ease-out; /* 平滑展開效果 */
        background-color: #fcfdfd;
        border-top: 1px dashed transparent;
    }

        /* 展開時的樣式 */
        .collapse-stepper.show {
            max-height: 150px; /* 給一個足夠的高度 */
            border-top: 1px dashed #eee;
            padding-top: 10px;
            margin-top: 15px;
        }

    /* 狀態點擊提示 */
    .status-clicker {
        cursor: pointer;
        transition: background 0.2s;
    }

        .status-clicker:hover {
            background: #f8f9fa;
        }
</style>

<div class="container-fluid pt-3">
   @if ((Model.VulnerabilityList != null && Model.VulnerabilityList.Any()) ||
     (Model.RequestList != null && Model.RequestList.Any()))
    {
        @foreach (var item in Model.VulnerabilityList)
        {
            // 狀態邏輯判斷
            string s1 = "", s2 = "", s3 = "", l1 = "", l2 = "";
            var st = item.Main.Status;
            var currentId = item.Main.Id;

            if (st == "Rejected") { s1 = s2 = s3 = "step-rejected"; }
            else if (st == "Pending") { s1 = "step-processing"; }
            else if (st == "PendingCross") { s1 = "step-active"; l1 = "line-active"; s2 = "step-processing"; }
            else if (st == "PendingCISO") { s1 = s2 = "step-active"; l1 = l2 = "line-active"; s3 = "step-processing"; }
            else if (st == "Approved") { s1 = s2 = s3 = "step-active"; l1 = l2 = "line-active"; }

            // --- 邏輯判斷區 ---

            // 1. 風險顏色判斷 (根據 Severity)
            string riskClass = "risk-low";
            if (item.Main.Severity?.Contains("中") == true) { riskClass = "risk-medium"; }
            else if (item.Main.Severity?.Contains("高") == true) { riskClass = "risk-high"; }
            else if (item.Main.Severity?.Contains("重大") == true) { riskClass = "risk-critical"; }

            // 2. 變更類型顏色判斷 (根據 ChangeType)
            string statusText = item.Main.ChangeType ?? "未分類";
            string statusClass = (statusText.Contains("緊急")) ? "status-rejected" : "status-approved";

            if (statusText.Contains("緊急")) { statusClass = "status-rejected"; }
            else if (statusText.Contains("例行") || statusText.Contains("標準")) { statusClass = "status-approved"; }

            <div class="custom-card">
                <div class="card-header-custom">
                    <div class="d-flex flex-column">
                        <span class="ticket-id">
                            @(string.IsNullOrEmpty(item.Main.TicketNumber) ? $"表單 #{item.Main.Id}" : item.Main.TicketNumber)
                        </span>
                        <span class="assigned-to">
                            <i class="bi bi-person-circle"></i> 提單人：
                            @if (item.Main.Requester != null)
                            {
                                @item.Main.Requester.UserName @:(@item.Main.Requester.Account)
                            }
                        </span>
                    </div>

                    <div class="badge-group text-end">
                        @* 💡 修改處：在狀態標籤加上 onclick 事件 *@
                        <span class="badge-status @statusClass me-1" onclick="toggleStepper('@item.Main.Id')">
                            @(st == "Rejected" ? "❌ 已退回" : st == "Approved" ? "✅ 准予實施" : "⏳ 審核中")
                            <small class="ms-1" style="font-size:0.6rem; opacity:0.8;">(點擊看進度)</small>
                        </span>

                        @if (!string.IsNullOrEmpty(item.Main.SystemCategory))
                        {
                            <span class="badge-system">@item.Main.SystemCategory</span>
                        }
                        @if (!string.IsNullOrEmpty(item.Main.TicketCategory))
                        {
                            <span class="badge-ticket-cat">@item.Main.TicketCategory</span>
                        }
                    </div>
                </div>

                <div class="summary-text">
                    <strong>變更摘要：</strong> @item.Main.Description
                </div>

                <div class="meta-info">
                    <div class="meta-item">
                        <span class="meta-label">🏷️ 類型：</span>
                        <span class="badge-status @statusClass">@statusText</span>
                    </div>

                    <div class="meta-item">
                        <span class="meta-label">📅 預計實施：</span>
                        <span>@item.Main.ScheduledTime?.ToString("yyyy/MM/dd HH:mm")</span>
                    </div>

                    <div class="meta-item">
                        <span class="meta-label">🛡️ 風險：</span>
                        <span class="badge-risk @riskClass">@(item.Main.Severity ?? "未評估")</span>
                    </div>

                    @if (!string.IsNullOrEmpty(item.Main.ImpactLevel))
                    {
                        <div class="meta-item">
                            <span class="meta-label">💥 影響：</span>
                            <span>@item.Main.ImpactLevel</span>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(item.Main.Dependency))
                    {
                        <div class="meta-item">
                            <span class="meta-label">🔗 依賴：</span>
                            <span>@item.Main.Dependency</span>
                        </div>
                    }
                </div>

                <div id="stepper-@item.Main.Id" class="collapse-stepper">
                    <div class="status-stepper">
                        <div class="step-item @s1">
                            <div class="step-dot"></div>
                            <div class="step-label">組長初審</div>
                        </div>
                        <div class="step-line @l1"></div>
                        <div class="step-item @s2">
                            <div class="step-dot"></div>
                            <div class="step-label">跨組覆核</div>
                        </div>
                        <div class="step-line @l2"></div>
                        <div class="step-item @s3">
                            <div class="step-dot"></div>
                            <div class="step-label">最終核准</div>
                        </div>
                    </div>

                    @if (st == "Rejected")
                    {
                        <div class="alert alert-danger py-1 px-3 small mx-3 mt-3" style="font-size: 0.8rem; border-radius: 10px;">
                            <strong>⚠️ 退回理由：</strong> @(item.LatestRejectReason ?? "請聯繫審核主管了解詳情")
                        </div>
                    }
                </div>

                <div class="text-end pt-2 d-flex justify-content-between align-items-center">
                    @* 💡 左下角加一個小提示，增加引導 *@
                    <button class="btn btn-link p-0 text-muted small text-decoration-none" onclick="toggleStepper('@item.Main.Id')">
                        <i class="bi bi-chevron-down"></i> 詳細審核進度
                    </button>

                    <a asp-page="/Vulnerabilities/Details" asp-route-id="@item.Main.Id" class="view-btn">
                        查看完整內容 &gt;
                    </a>
                </div>
            </div>
        }
       
  @foreach (var item in Model.RequestList)
{
    // ===== 需求單審核進度邏輯 =====
    string rs1 = "", rs2 = "", rs3 = "", rl1 = "", rl2 = "";
    var rst = item.Main.Status;

    if (rst == 4)
    {
        rs1 = rs2 = rs3 = "step-rejected";
    }
    else if (rst == 0)
    {
        rs1 = "step-processing";
    }
    else if (rst == 1)
    {
        rs1 = "step-active";
        rl1 = "line-active";
        rs2 = "step-processing";
    }
    else if (rst == 3)
    {
        rs1 = rs2 = rs3 = "step-active";
        rl1 = rl2 = "line-active";
    }
    else
    {
        rs1 = "step-processing";
    }

    // ===== 狀態標籤文字與顏色 =====
    string requestStatusText = "⏳ 審核中";
    string requestStatusClass = "status-pending";

    if (rst == 4)
    {
        requestStatusText = "❌ 已退回";
        requestStatusClass = "status-rejected";
    }
    else if (rst == 3)
    {
        requestStatusText = "✅ 已完成";
        requestStatusClass = "status-approved";
    }
    else if (rst == 1 || rst == 0)
    {
        requestStatusText = "⏳ 審核中";
        requestStatusClass = "status-pending";
    }

    var titleText = string.IsNullOrWhiteSpace(item.Main.Title) ? "未填寫標題" : item.Main.Title;
    var systemCategory = string.IsNullOrWhiteSpace(item.Main.UserInput?.SystemCategory) ? "未分類" : item.Main.UserInput.SystemCategory;
    var department = string.IsNullOrWhiteSpace(item.Main.UserInput?.Department) ? "未知部門" : item.Main.UserInput.Department;
    var requesterText = item.Main.RequesterId.ToString();

    <div class="custom-card">
        <div class="card-header-custom">
            <div class="d-flex flex-column">
                <span class="ticket-id">
                    @(string.IsNullOrEmpty(item.Main.TicketNumber) ? $"需求單 #{item.Main.Id}" : item.Main.TicketNumber)
                </span>
                <span class="assigned-to">
                    <i class="bi bi-person-circle"></i> 提單人：@requesterText
                </span>
            </div>

            <div class="badge-group text-end">
                <span class="badge-status @requestStatusClass me-1"
                      onclick="document.getElementById('request-stepper-@item.Main.Id').classList.toggle('show')"
                      style="cursor:pointer;">
                    @requestStatusText
                    <small class="ms-1" style="font-size:0.6rem; opacity:0.8;">(點擊看進度)</small>
                </span>

                <span class="badge-system">@systemCategory</span>
                <span class="badge-ticket-cat">需求單</span>
            </div>
        </div>

        <div class="summary-text">
            <strong>需求摘要：</strong> @titleText
        </div>

        <div class="meta-info">
            <div class="meta-item">
                <span class="meta-label">🏷️ 類型：</span>
                <span class="badge-status status-approved">一般需求</span>
            </div>

            <div class="meta-item">
                <span class="meta-label">📅 建立時間：</span>
                <span>@item.Main.CreatedAt.ToString("yyyy/MM/dd HH:mm")</span>
            </div>

            <div class="meta-item">
                <span class="meta-label">🏥 系統類別：</span>
                <span>@systemCategory</span>
            </div>

            <div class="meta-item">
                <span class="meta-label">🏢 部門：</span>
                <span>@department</span>
            </div>
        </div>

        <div id="request-stepper-@item.Main.Id" class="collapse-stepper">
            <div class="status-stepper">
                <div class="step-item @rs1">
                    <div class="step-dot"></div>
                    <div class="step-label">AI 初審</div>
                </div>
                <div class="step-line @rl1"></div>
                <div class="step-item @rs2">
                    <div class="step-dot"></div>
                    <div class="step-label">開發人員審核</div>
                </div>
                <div class="step-line @rl2"></div>
                <div class="step-item @rs3">
                    <div class="step-dot"></div>
                    <div class="step-label">通過</div>
                </div>
            </div>

            @if (rst == 4)
            {
                <div class="alert alert-danger py-2 px-3 small mx-3 mt-3" style="font-size: 0.9rem; border-radius: 14px;">
                    <strong>⚠️ 退回理由：</strong> @(item.LatestRejectReason ?? "請聯繫開發人員了解詳情")
                </div>
            }
        </div>

        <div class="text-end pt-2 d-flex justify-content-between align-items-center">
            <button type="button"
                    class="btn btn-link p-0 text-muted small text-decoration-none"
                    onclick="document.getElementById('request-stepper-@item.Main.Id').classList.toggle('show')">
                <i class="bi bi-chevron-down"></i> 詳細審核進度
            </button>

            <a asp-page="/Request/Details" asp-route-id="@item.Main.Id" class="view-btn">
                查看完整內容 &gt;
            </a>
        </div>
    </div>
}
}
    
    else
    {
        <div class="alert alert-info mt-4 text-center">
    <i class="bi bi-info-circle"></i> 目前沒有任何表單紀錄。
</div>
    }
</div>

<script>
    function toggleStepper(id) {
        const el = document.getElementById('stepper-' + id);
        if (el) {
            el.classList.toggle('show');

            // 可選：切換按鈕圖示方向
            const icon = el.parentElement.querySelector('.bi-chevron-down, .bi-chevron-up');
            if (icon) {
                icon.classList.toggle('bi-chevron-down');
                icon.classList.toggle('bi-chevron-up');
            }
        }
    }
    
</script>