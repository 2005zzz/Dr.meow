<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Dr.meow</title>

    <!-- ✅ Bootstrap CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">


    <!-- ✅ 站內 CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
        :root {
            --meow-green: #3AB6A7;
            --meow-green-light: #E8F8F6;
        }

        body {
            background: var(--meow-green-light) !important;
            font-family: "Segoe UI", sans-serif;
        }

        .navbar {
            background-color: var(--meow-green) !important;
        }

        .footer {
            background-color: var(--meow-green) !important;
            color: white !important;
            padding: 10px 0;
        }

        .navbar-brand img {
            height: 60px;
            border-radius: 10px;
            transition: 0.25s;
        }

            .navbar-brand img:hover {
                transform: scale(1.1);
            }

        /* 卡片美化 */
        .card {
            border: none;
            border-radius: 12px;
        }

        .card-header {
            background: white !important;
            font-weight: 600;
        }

        /* 按鈕主題統一 */
        .btn-primary {
            background-color: var(--meow-green) !important;
            border-color: var(--meow-green) !important;
        }

            .btn-primary:hover {
                filter: brightness(1.12);
            }
    </style>

</head>
<body class="d-flex flex-column min-vh-100">
    @{
        // 目前 Razor Page 名稱，例如 "/Login"、"/AdminHome"、"/UserHome"
        var currentPage = (ViewContext.RouteData.Values["page"] as string) ?? "";
        var showBell = !string.Equals(currentPage, "/Login", StringComparison.OrdinalIgnoreCase);
    }

    <!-- ✅ 頂部綠色導覽列 -->
    <header>
        <nav class="navbar border-bottom box-shadow mb-3" style="background-color:#3AB6A7;">
            <div class="container d-flex align-items-center justify-content-between">
                <!-- 左側 LOGO -->
                <a class="navbar-brand d-flex align-items-center gap-3 text-white" asp-page="/Index">
                    <img src="~/images/drmeow-logo.png" alt="Dr.Meow Logo"
                         style="height:60px;width:auto;border-radius:10px;">
                    <span class="fw-bold" style="font-size:1.4rem;">Dr.meow</span>
                </a>

                <!-- 右上角鈴鐺通知按鈕：只有不是 Login 頁才顯示 -->
                @if (showBell)
                {
                    <div class="dropdown">
                        <button class="btn btn-light position-relative" id="notifyBell" data-bs-toggle="dropdown">
                            <span class="fs-5">🔔查看通知</span>
                            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                                3
                            </span>
                        </button>

                        <ul class="dropdown-menu dropdown-menu-end shadow-sm" style="width: 260px;">
                            <li class="dropdown-header fw-bold">通知中心</li>
                            <li><hr class="dropdown-divider" /></li>
                            <li><a class="dropdown-item small" href="#">📄 您有 1 筆待審核表單</a></li>
                            <li><a class="dropdown-item small" href="#">🛠️ DevOps-20231027-001 已提交</a></li>
                            <li><a class="dropdown-item small" href="#">❌ 有表單被退回需要處理</a></li>
                            <li><hr class="dropdown-divider" /></li>
                            <li><a class="dropdown-item text-center small text-primary" href="#">查看全部通知 &gt;</a></li>
                        </ul>
                    </div>
                }
            </div>
        </nav>
    </header>

    <!-- ✅ 主要內容區：會自動撐開 -->
    <main class="flex-grow-1 text-dark">
        <div class="container pb-4">
            @RenderBody()
        </div>
    </main>

    <!-- ✅ 底部綠邊永遠貼底 -->
    <footer class="text-center text-white py-3" style="background-color:#3AB6A7;">
        © 2025 Dr.meow 智慧資安顧問系統
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
