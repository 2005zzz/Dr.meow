<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Dr.meow</title>

    <!-- ✅ Bootstrap CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- ✅ 站內 CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
        :root {
            --meow-green: #3AB6A7;
            --meow-green-light: #E8F8F6;
        }

        body {
            background: var(--meow-green-light) !important;
            font-family: "Segoe UI", sans-serif;
        }

        .navbar {
            background-color: var(--meow-green) !important;
        }

        .footer {
            background-color: var(--meow-green) !important;
            color: white !important;
            padding: 10px 0;
        }

        .navbar-brand img {
            height: 60px;
            border-radius: 10px;
            transition: 0.25s;
        }

            .navbar-brand img:hover {
                transform: scale(1.1);
            }

        /* 卡片美化 */
        .card {
            border: none;
            border-radius: 12px;
        }

        .card-header {
            background: white !important;
            font-weight: 600;
        }

        /* 按鈕主題統一 */
        .btn-primary {
            background-color: var(--meow-green) !important;
            border-color: var(--meow-green) !important;
        }

            .btn-primary:hover {
                filter: brightness(1.12);
            }
    </style>

</head>
<body class="d-flex flex-column min-vh-100">

    <!-- ✅ 頂部綠色導覽列 -->
    <header>
        <nav class="navbar border-bottom box-shadow mb-3" style="background-color:#3AB6A7;">
            <div class="container d-flex align-items-center">
                <a class="navbar-brand d-flex align-items-center gap-3 text-white" asp-page="/Index">
                    <img src="~/images/drmeow-logo.png" alt="Dr.Meow Logo" style="height:60px;width:auto;border-radius:10px;">
                    <span class="fw-bold" style="font-size:1.4rem;">Dr.meow</span>
                </a>
                <ul class="navbar-nav ms-auto"></ul>
            </div>
        </nav>
    </header>

    <!-- ✅ 主要內容區：會自動撐開 -->
    <main class="flex-grow-1">
        <div class="container pb-4">
            @RenderBody()
        </div>
    </main>

    <!-- ✅ 底部綠邊永遠貼底 -->
    <footer class="text-center text-white py-3" style="background-color:#3AB6A7;">
        © 2025 Dr.meow 智慧資安顧問系統
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>
