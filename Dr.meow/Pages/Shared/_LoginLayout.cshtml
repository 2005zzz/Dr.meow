@{
    var currentPage = ViewContext.RouteData.Values["page"]?.ToString() ?? "";
}

<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Dr.meow</title>

    <!-- Bootstrap & Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />

    <!-- 全站 CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
        body {
            background: linear-gradient(180deg,#f7fdfc 0%,#ecfaf7 40%,#dff7f2 100%);
        }

        /* ✨ 質感 Logo Hover（漂亮又低調） */
        .drmeow-logo {
            border-radius: 10px;
            transition: transform 0.22s ease, box-shadow 0.22s ease, filter 0.22s ease;
        }

            .drmeow-logo:hover {
                transform: translateY(-1px) scale(1.03);
                filter: brightness(1.06);
                box-shadow: 0 6px 16px rgba(0,0,0,0.18);
                cursor: pointer;
            }
    </style>
</head>

<body class="d-flex flex-column min-vh-100">

    <!-- ✅ 頂部 Navbar -->
    <header>
        <nav class="navbar border-bottom box-shadow mb-3" style="background-color:#3AB6A7;">
            <div class="container d-flex align-items-center justify-content-between">

                <!-- 左：Logo + 名稱 -->
                <a class="navbar-brand d-flex align-items-center gap-3 text-white" asp-page="/Index">
                    <img src="~/images/drmeow-logo.png"
                         alt="Dr.Meow Logo"
                         class="drmeow-logo"
                         style="height:60px;width:auto;">
                    <span class="fw-bold" style="font-size:1.4rem;">Dr.meow</span>
                </a>

                <!-- 右：通知鈴鐺（登入頁不顯示） -->
                @if (!string.Equals(currentPage, "/Login", System.StringComparison.OrdinalIgnoreCase))
                {
                    <div class="d-flex align-items-center">
                        <div class="nav-item dropdown">
                            <a class="btn-icon-notification"
                               href="#"
                               id="notifDropdown"
                               role="button"
                               data-bs-toggle="dropdown"
                               aria-expanded="false">
                                <i class="bi bi-bell-fill"></i>
                                <span class="notification-badge"></span>
                            </a>

                            <!-- 下拉通知 -->
                            <ul class="dropdown-menu dropdown-menu-end notifications-menu"
                                aria-labelledby="notifDropdown">
                                <li class="notifications-header">最近通知</li>
                                <li class="notifications-footer">
                                    <a href="#">查看全部通知</a>
                                </li>
                            </ul>
                        </div>
                    </div>
                }
            </div>
        </nav>
    </header>

    <!-- ⭐ 內容區：置中顯示 Login 卡片 -->
    <main class="flex-grow-1 d-flex align-items-center">
        <div class="container d-flex justify-content-center">
            @RenderBody()
        </div>
    </main>

    <!-- Footer -->
    <footer class="text-center text-white py-3" style="background-color:#3AB6A7;">
        © 2025 Dr.meow 智慧資安顧問系統
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
