<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Dr.meow</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
        body {
            background: linear-gradient(180deg,#f7fdfc 0%,#ecfaf7 40%,#dff7f2 100%);
        }

        .drmeow-logo {
            border-radius: 10px;
            transition: transform 0.22s ease, box-shadow 0.22s ease, filter 0.22s ease;
        }

            .drmeow-logo:hover {
                transform: translateY(-1px) scale(1.03);
                filter: brightness(1.06);
                box-shadow: 0 6px 16px rgba(0,0,0,0.18);
                cursor: pointer;
            }
    </style>
</head>

<body class="d-flex flex-column min-vh-100">

    <header>
        <nav class="navbar border-bottom box-shadow mb-3" style="background-color:#3AB6A7;">
            <div class="container d-flex align-items-center">

                <a class="navbar-brand d-flex align-items-center gap-3 text-white m-0"
                   asp-page="/Login/Login">

                    <img src="~/images/drmeow-logo.png"
                         alt="Dr.Meow Logo"
                         class="drmeow-logo"
                         style="height:60px;width:auto;">

                    <span class="fw-bold" style="font-size:1.4rem;">
                        Dr.meow
                    </span>

                </a>

            </div>
        </nav>
    </header>

    <main class="flex-grow-1 d-flex align-items-center">
        <div class="container d-flex justify-content-center">
            @RenderBody()
        </div>
    </main>

    <footer class="text-center text-white py-3" style="background-color:#3AB6A7;">
        © 2025 Dr.meow 智慧資安顧問系統
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>