@page
@model Dr.meow.Pages.IndexModel
@{
    ViewData["Title"] = "顧問中心";
}

<div class="row g-3">
    <!-- 左側選單 -->
    <aside class="col-12 col-lg-3">
        <div class="card shadow-sm">
            <div class="list-group list-group-flush app-sidebar">

                <!-- 標題：功能 -->
                <div class="list-group-item text-secondary small text-uppercase">功能</div>

                <!-- RAG 顧問（留在首頁，用 JS 切換模式） -->
                <a class="list-group-item list-group-item-action app-menu active"
                   data-mode="consult">
                    RAG 顧問
                </a>

                <!-- 表單管理（跳轉到 Vulnerabilities/Index.cshtml） -->
                <a class="list-group-item list-group-item-action"
                   asp-page="/Vulnerabilities/Index">
                    表單管理
                </a>

                <!-- 報表分析（留在首頁，用 JS 切換模式） -->
                <a class="list-group-item list-group-item-action app-menu"
                   data-mode="reports">
                    報表分析
                </a>

                <!-- 標題：常見問題 -->
                <div class="list-group-item text-secondary small text-uppercase">常見問題</div>

                <!-- 固定主題 -->
                <a class="list-group-item list-group-item-action app-topic" data-prompt="ISO27001">ISO27001</a>
                <a class="list-group-item list-group-item-action app-topic" data-prompt="電腦設備異常處理">電腦設備異常處理</a>
                <a class="list-group-item list-group-item-action app-topic" data-prompt="資訊安全內部稽核">資訊安全內部稽核</a>
                <a class="list-group-item list-group-item-action app-topic" data-prompt="帳號權限管理">帳號權限管理</a>
            </div>
        </div>
    </aside>


    <!-- 右側主區 -->
    <section class="col-12 col-lg-9">
        <div class="card shadow-sm">
            <div class="card-header bg-white">
                <h5 class="mb-0">Dr.Meow（顧問中心）</h5>
            </div>
            <div class="card-body">
                <div id="noteBox" class="alert alert-info py-2">
                    左側可切換模式，下方輸入問題按送出。現在會呼叫後端 /Api/Search 取得真實資料。
                </div>

                <!-- ✅ 泡泡聊天區 -->
                <div id="messages" class="chat-stream mb-3"></div>

                <div id="summaryBox" class="alert alert-secondary d-none"></div>
                <div id="results" class="row row-cols-1 row-cols-md-2 g-3 mt-1"></div>

                <!-- 輸入列 -->
                <form id="askForm" class="row g-2 mt-2">
                    <div class="col">
                        <input id="askInput" class="form-control"
                               placeholder="輸入問題，例如：最近漏洞通報與處置建議？" autocomplete="off" />
                    </div>
                    <div class="col-auto d-flex gap-2">
                        <button id="btnVoice" class="btn btn-outline-secondary" type="button">🔍 語音</button>
                        <button class="btn btn-primary" type="submit">送出</button>
                        <button id="btnClear" class="btn btn-outline-secondary" type="button">清空</button>
                    </div>
                </form>
            </div>
        </div>
    </section>
</div>

@section Scripts {
    <script>
        // === 設定：真正打到 Razor Page 的 API ===
        const API_URL = '/Api/Search';

        /* 取 DOM */
        const menuItems = document.querySelectorAll('.app-menu');
        const topics    = document.querySelectorAll('.app-topic');
        const noteBox   = document.getElementById('noteBox');
        const msgs      = document.getElementById('messages');   // <- 泡泡容器
        const results   = document.getElementById('results');
        const summary   = document.getElementById('summaryBox');
        const form      = document.getElementById('askForm');
        const input     = document.getElementById('askInput');
        const btnClear  = document.getElementById('btnClear');
        const btnVoice  = document.getElementById('btnVoice');

        /* 左側點選高亮（點選即變，不用 hover） */
        menuItems.forEach(it => {
            it.addEventListener('click', () => {
                menuItems.forEach(x => x.classList.remove('active'));
                it.classList.add('active');
                const mode = it.dataset.mode;
                if (!mode) return;
                const txt = mode === 'consult' ? 'RAG 顧問'
                          : mode === 'forms'   ? '表單管理'
                          : '報表分析';
                noteBox.textContent = `已切換至「${txt}」。`;
                msgs.innerHTML = '';
                results.innerHTML = '';
                summary.classList.add('d-none');
            });
        });

        /* 主題快捷鍵 */
        topics.forEach(tp => {
            tp.addEventListener('click', () => {
                input.value = `請提供「${tp.dataset.prompt}」的作業重點與處置流程`;
                input.focus();
            });
        });

        /* 送出：顯示泡泡 + 呼叫 /Api/Search 拿真實資料 */
        form.addEventListener('submit', async (e) => {
            e.preventDefault();
            const q = input.value.trim();
            if (!q) return;

            // 顯示使用者提問
            pushUser(q);
            input.value = '';

            // 顯示「查詢中」泡泡
            pushBot('查詢中，請稍候…');

            try {
                const resp = await fetch(`${API_URL}?keyword=${encodeURIComponent(q)}`);
                if (!resp.ok) {
                    const text = await resp.text();
                    replaceLastBot(`後端發生錯誤（${resp.status}）：${text}`);
                    summary.classList.add('d-none');
                    results.innerHTML = '';
                    return;
                }

                const data = await resp.json();  // 預期是 { answer: "...", items: [...] }

                // 更新最後一則機器人訊息為真正的回答
                const answerText = data.answer || '（沒有取得 AI 回覆）';
                replaceLastBot(answerText);

                // 上方 summary 區顯示一次總結
                summary.classList.remove('d-none');
                summary.textContent = answerText;

                // 下方文件卡片
                results.innerHTML = '';
                (data.items || []).forEach(addResultCard);

                scrollBottom();
            } catch (err) {
                console.error(err);
                replaceLastBot('查詢失敗，請稍後再試。');
                summary.classList.add('d-none');
                results.innerHTML = '';
            }
        });

        /* 清空 */
        btnClear.addEventListener('click', () => {
            msgs.innerHTML = '';
            results.innerHTML = '';
            summary.classList.add('d-none');
        });

        /* === 泡泡工具 === */
        function pushUser(t) {
            msgs.insertAdjacentHTML('beforeend', `
            <div class="msg-row">
              <div class="msg msg-user">${escapeHtml(t)}</div>
            </div>`);
        }
        function pushBot(t) {
            msgs.insertAdjacentHTML('beforeend', `
            <div class="msg-row">
              <div class="msg msg-bot" data-bot="1">${escapeHtml(t)}</div>
            </div>`);
        }
        function replaceLastBot(t) {
            const els = [...document.querySelectorAll('[data-bot="1"]')];
            const last = els.pop();
            if (last) last.innerHTML = escapeHtml(t);
        }
        function scrollBottom() {
            msgs.scrollTop = msgs.scrollHeight;
        }
        function escapeHtml(s) {
            return (s || '').replace(/[&<>"']/g, m => ({
                '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
            }[m]));
        }

        /* 文件卡片 */
        function addResultCard(x) {
            results.insertAdjacentHTML('beforeend', `
            <div class="col">
              <div class="card result-card h-100">
                <div class="card-body">
                  <div class="d-flex justify-content-between align-items-center">
                    <div class="result-title">
                      <a href="${x.url || '#'}" target="_blank">
                        ${escapeHtml(x.title || '（無標題）')}
                      </a>
                    </div>
                    <span class="badge bg-success-subtle text-success-emphasis border border-success-subtle">
                      ${escapeHtml(x.source || '')}
                    </span>
                  </div>
                  <div class="text-secondary small mb-2">
                    ${x.modifiedAt ? new Date(x.modifiedAt).toLocaleDateString() : ''}
                  </div>
                  <div class="mb-3">${escapeHtml(x.snippet || '')}</div>
                  <div class="d-flex gap-2">
                    <a class="btn btn-outline-primary btn-sm" target="_blank" href="${x.url || '#'}">開啟文件</a>
                    <a class="btn btn-success btn-sm" href="/Incidents/New">新增為事件</a>
                  </div>
                </div>
              </div>
            </div>`);
        }

        const sleep = (ms) => new Promise(r => setTimeout(r, ms));

        /* 語音：Web Speech API（可用 Chrome/Edge + localhost/HTTPS） */
        (function () {
            const SR = window.SpeechRecognition || window.webkitSpeechRecognition;
            if (!SR) return;
            const recog = new SR();
            recog.lang = 'zh-TW';
            recog.continuous = false;
            recog.interimResults = true;

            let listening = false;
            btnVoice.addEventListener('click', () => { listening ? stop() : start(); });
            function start() { try { recog.start(); listening = true; btnVoice.textContent = '🎙️ 辨識中…'; } catch (e) { } }
            function stop() { try { recog.stop(); listening = false; btnVoice.textContent = '🔍 語音'; } catch (e) { } }

            recog.onresult = (e) => {
                let final = '', interim = '';
                for (let i = e.resultIndex; i < e.results.length; i++) {
                    const text = e.results[i][0].transcript;
                    if (e.results[i].isFinal) final += text;
                    else interim += text;
                }
                input.value = (final || interim).trim();
            };
            recog.onend = () => { listening = false; btnVoice.textContent = '🔍 語音'; };
        })();
    </script>
}
