@page
@model Dr.meow.Pages.Vulnerabilities.IndexModel

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="display-4">新增變更申請單</h1>
        <div>
            <a asp-page-handler="ExportToExcel" class="btn btn-success shadow-sm me-2">
                <i class="fas fa-file-excel me-1"></i> 匯出Excel檔案
            </a>
            <a asp-page="Create" class="btn btn-primary shadow-sm">
                <i class="fas fa-plus-circle me-2"></i> 新增表單
            </a>
        </div>
    </div>
    <table class="table">
        <thead>
            <tr>
                <th>
                    @Html.DisplayNameFor(model => model.Vulnerability[0].Title)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Vulnerability[0].Status)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Vulnerability[0].Severity)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Vulnerability[0].FoundDate)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Vulnerability[0].AssignedTo)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Vulnerability[0].Description)
                </th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Vulnerability)
            {
                <tr>
                    <td>
                        @Html.DisplayFor(modelItem => item.Title)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Status)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Severity)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.FoundDate)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.AssignedTo)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Description)
                    </td>
                    <td>
                        <a asp-page="./Edit" asp-route-id="@item.Id">Edit</a> |
                        <a asp-page="./Details" asp-route-id="@item.Id">Details</a> |
                        <a asp-page="./Delete" asp-route-id="@item.Id">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
