@page
@model Dr.meow.Pages.Vulnerabilities.DetailsModel

@{
    ViewData["Title"] = "表單詳細內容";
}

<style>
    /* 保留原本的 CSS 樣式 */
    .vuln-details-page .card {
        border-radius: 22px;
        background: rgba(255,255,255,0.96);
        border: 1px solid rgba(255,255,255,0.9);
        box-shadow: 0 18px 40px rgba(47,110,100,0.18);
        overflow: hidden;
    }

    .vuln-details-page .details-header {
        background: linear-gradient(135deg,#8fdacb,#64bba8);
        color: #ffffff;
        padding: 16px 24px;
        border-bottom: 1px solid rgba(255,255,255,0.6);
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .vuln-details-page .details-header-icon {
        width: 32px;
        height: 32px;
        border-radius: 999px;
        background: rgba(255,255,255,0.16);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.2rem;
    }

    .vuln-details-page .details-header-title {
        font-size: 1.3rem;
        font-weight: 700;
        letter-spacing: .03em;
    }

    .vuln-details-page .card-body {
        padding: 22px 26px 20px;
    }

    .vuln-details-page dl {
        margin-bottom: 0.5rem;
    }

    .vuln-details-page dt {
        font-weight: 600;
        color: #425b58;
        margin-top: 0.8rem; /* 增加間距讓閱讀更舒適 */
        font-size: 0.95rem;
    }

    .vuln-details-page dd {
        margin-bottom: 0.35rem;
        color: #333;
    }

    /* 標籤樣式 */
    .vuln-details-page .field-chip {
        display: inline-block;
        padding: 4px 12px;
        border-radius: 999px;
        font-size: 0.85rem;
        background: #f2faf8;
        border: 1px solid rgba(143,218,203,0.7);
        color: #2f6e64;
        margin-right: 5px;
        font-weight: 500;
    }

    /* 風險等級顏色 */
    .vuln-details-page .severity-low {
        background: #e6f6ff;
        border-color: #9fd3ff;
        color: #1f567a;
    }

    .vuln-details-page .severity-medium {
        background: #fff6e1;
        border-color: #ffd08a;
        color: #8a5a17;
    }

    .vuln-details-page .severity-high {
        background: #ffe9ea;
        border-color: #ff9ba0;
        color: #8a1f2a;
    }

    .vuln-details-page .severity-critical {
        background: #dc3545;
        border-color: #dc3545;
        color: #fff;
    }
    /* 新增重大風險 */

    .vuln-details-page .desc-box {
        padding: 15px;
        border-radius: 12px;
        background: #f8fbfb;
        border: 1px solid rgba(143,218,203,0.4);
        min-height: 80px;
        white-space: pre-wrap; /* 保留換行 */
        line-height: 1.6;
    }

    /* 按鈕樣式 */
    .vuln-details-page .btn-edit {
        border-radius: 999px;
        padding: 8px 24px;
        font-weight: 600;
        border: none;
        background: linear-gradient(135deg,#8fdacb,#64bba8);
        color: #ffffff;
        box-shadow: 0 10px 22px rgba(47,110,100,0.28);
        transition: 0.18s ease;
        text-decoration: none;
    }

        .vuln-details-page .btn-edit:hover {
            background: linear-gradient(135deg,#7bcbbd,#51a798);
            transform: translateY(-1px);
            color: #ffffff;
        }

    .vuln-details-page .btn-delete {
        border-radius: 999px;
        padding: 8px 22px;
        font-weight: 600;
        border: 1px solid #e04444;
        background-color: #f3b7b7;
        color: #ffffff;
        text-decoration: none;
        transition: 0.15s ease;
    }

        .vuln-details-page .btn-delete:hover {
            background-color: #e0a0a0;
            color: #ffffff;
        }

    .vuln-details-page .btn-back {
        border-radius: 999px;
        padding: 8px 22px;
        font-weight: 500;
        border: 1px solid #cfd4da;
        background-color: #f7f7f8;
        color: #4c5a64;
        text-decoration: none;
        transition: 0.15s ease;
    }

        .vuln-details-page .btn-back:hover {
            background-color: #eceff3;
            color: #4c5a64;
        }
</style>

<div class="vuln-details-page container mt-4 mb-4">
    <div class="card">
        <div class="details-header">
            <div class="details-header-icon">
                📄
            </div>
            <div>
                <div class="details-header-title">表單詳細內容</div>
                <div class="small" style="opacity:.9;">
                    單號：@(string.IsNullOrEmpty(Model.Vulnerability.TicketNumber) ? $"#{Model.Vulnerability.Id}" : Model.Vulnerability.TicketNumber)
                </div>
            </div>
        </div>

        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">系統 / 工單類別</dt>
                <dd class="col-sm-9">
                    @if (!string.IsNullOrEmpty(Model.Vulnerability.SystemCategory))
                    {
                        <span class="field-chip">@Model.Vulnerability.SystemCategory</span>
                    }
                    @if (!string.IsNullOrEmpty(Model.Vulnerability.TicketCategory))
                    {
                        <span class="field-chip">@Model.Vulnerability.TicketCategory</span>
                    }
                </dd>

                <dt class="col-sm-3">變更類型 (Type)</dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.Vulnerability.ChangeType)
                </dd>

                <dt class="col-sm-3">風險評估 (Severity)</dt>
                <dd class="col-sm-9">
                    @{
                        var sev = Model.Vulnerability.Severity?.Trim() ?? "";
                        var sevClass = "severity-low";
                        if (sev.Contains("重大")) { sevClass = "severity-critical"; }
                        else if (sev.Contains("高")) { sevClass = "severity-high"; }
                        else if (sev.Contains("中")) { sevClass = "severity-medium"; }
                    }
                    <span class="field-chip @sevClass">
                        @(string.IsNullOrEmpty(sev) ? "未評估" : sev)
                    </span>
                </dd>

                <dt class="col-sm-3">影響與依賴</dt>
                <dd class="col-sm-9">
                    <div><strong>影響程度：</strong> @Html.DisplayFor(model => model.Vulnerability.ImpactLevel)</div>
                    <div><strong>系統依賴：</strong> @Html.DisplayFor(model => model.Vulnerability.Dependency)</div>
                </dd>

                <dt class="col-sm-3">預計實施時間</dt>
                <dd class="col-sm-9">
                    @* 🚀 修正：FoundDate 已刪除，統一顯示 ScheduledTime (DateTime 型態) *@
                    @if (Model.Vulnerability.ScheduledTime.HasValue)
                    {
                        @Model.Vulnerability.ScheduledTime.Value.ToString("yyyy/MM/dd HH:mm")
                    }
                    else
                    {
                        <span class="text-muted">尚未排定時間</span>
                    }
                </dd>

                <dt class="col-sm-3">計畫確認</dt>
                <dd class="col-sm-9">
                    <div><strong>測試計畫：</strong> @Html.DisplayFor(model => model.Vulnerability.TestPlan)</div>
                    <div><strong>回復計畫：</strong> @Html.DisplayFor(model => model.Vulnerability.RecoveryPlan)</div>
                </dd>

                <dt class="col-sm-3">提單人 (AssignedTo)</dt>
                <dd class="col-sm-9">
                    @* 🚀 修正：AssignedTo 已改為 Requester 關聯 *@
                    @if (Model.Vulnerability.Requester != null)
                    {
                        <span class="badge bg-light text-dark border">
                            <i class="bi bi-person"></i> @Model.Vulnerability.Requester.UserName (@Model.Vulnerability.Requester.Account)
                        </span>
                    }
                    else
                    {
                        @:系統管理員 (ID: @Model.Vulnerability.RequesterId)
                    }
                </dd>

                <dt class="col-sm-3">流程狀態 (Status)</dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.Vulnerability.Status)
                </dd>

                <dt class="col-sm-3">變更內容 (Description)</dt>
                <dd class="col-sm-9">
                    <div class="desc-box">
                        @Html.DisplayFor(model => model.Vulnerability.Description)
                    </div>
                </dd>
            </dl>

            <div class="mt-4">
                <a asp-page="./Edit" asp-route-id="@Model.Vulnerability.Id" class="btn-edit">
                    <i class="bi bi-pencil-square"></i> 編輯表單
                </a>

                <a asp-page="./Delete" asp-route-id="@Model.Vulnerability.Id" class="btn-delete ms-2">
                    <i class="bi bi-trash"></i> 刪除
                </a>

            </div>
        </div>
    </div>
</div>