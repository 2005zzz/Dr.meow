@page
@model Dr.meow.Pages.Vulnerabilities.ChangeManagementModel

@{
    Layout = null;
}

@functions {
    string GetText(object obj, params string[] names)
    {
        if (obj == null) return "";
        foreach (var name in names)
        {
            var prop = obj.GetType().GetProperty(name);
            if (prop != null)
            {
                var value = prop.GetValue(obj);
                if (value != null && !string.IsNullOrWhiteSpace(value.ToString()))
                    return value.ToString();
            }
        }
        return "";
    }

    string GetDate(object obj, params string[] names)
    {
        if (obj == null) return "";
        foreach (var name in names)
        {
            var prop = obj.GetType().GetProperty(name);
            if (prop != null)
            {
                var value = prop.GetValue(obj);
                if (value is DateTime dt) return dt.ToString("yyyy/MM/dd HH:mm");
                if (value != null && DateTime.TryParse(value.ToString(), out var parsed))
                    return parsed.ToString("yyyy/MM/dd HH:mm");
            }
        }
        return "";
    }

    int GetId(object obj)
    {
        var prop = obj.GetType().GetProperty("Id");
        if (prop == null) return 0;
        var value = prop.GetValue(obj);
        return value == null ? 0 : Convert.ToInt32(value);
    }

    void RenderList(List<Dr.meow.Pages.Vulnerabilities.ChangeManagementModel.VulnerabilityVM> list)
    {
    }
}

<style>
    .status-tabs {
        display: flex;
        gap: 16px;
        margin-bottom: 24px;
        flex-wrap: wrap;
    }

    .status-tab {
        border: none;
        background: #f4f7f8;
        border-radius: 999px;
        padding: 10px 20px;
        font-weight: 700;
        font-size: 16px;
        color: #456;
        display: flex;
        align-items: center;
        gap: 10px;
        cursor: pointer;
    }

        .status-tab.active {
            background: #ffeeba;
        }

    .status-count {
        color: white;
        border-radius: 999px;
        min-width: 34px;
        height: 34px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 15px;
        font-weight: 800;
    }

    .tab-panel {
        display: none;
    }

        .tab-panel.active {
            display: block;
        }

    .review-item {
        background: #fff;
        border-radius: 20px;
        max-width: 820px;
        margin: 20px auto;
        padding: 22px 24px;
        box-shadow: 0 6px 18px rgba(0,0,0,.06);
        border-left: 5px solid #7ed6c7;
    }

    .review-id {
        font-size: 22px;
        font-weight: 800;
        color: #233;
        margin-bottom: 12px;
    }

    .review-meta {
        color: #666;
        margin-bottom: 12px;
        font-size: 14px;
    }

    .review-summary {
        font-size: 16px;
        font-weight: 700;
        margin-bottom: 16px;
        color: #344;
    }

    .review-info-row {
        background: #f7fafa;
        border-radius: 14px;
        padding: 14px;
        display: flex;
        flex-wrap: wrap;
        gap: 18px;
        margin-bottom: 18px;
    }

    .review-info-item {
        color: #445;
        font-size: 14px;
        font-weight: 600;
    }

    .badge-soft {
        border-radius: 999px;
        padding: 6px 12px;
        font-size: 13px;
        font-weight: 700;
    }

    .badge-green {
        background: #d9f5e9;
        color: #198754;
    }

    .badge-yellow {
        background: #fff3cd;
        color: #997404;
    }

    .detail-link {
        color: #0d6efd;
        font-weight: 700;
        text-decoration: none;
        font-size: 16px;
    }

    .review-actions {
        display: flex;
        gap: 12px;
        margin-top: 16px;
    }

    .btn-review {
        border: none;
        border-radius: 999px;
        padding: 10px 18px;
        font-size: 14px;
        font-weight: 700;
        cursor: pointer;
    }

    .btn-approve {
        background: #63c6b7;
        color: white;
    }

    .btn-reject {
        background: #ffe5e5;
        color: #d9534f;
    }

    .empty-box {
        text-align: center;
        padding: 50px 20px;
        color: #888;
        font-size: 18px;
    }
</style>

<div class="admin-review-card">

    <div class="status-tabs">

        <button type="button" class="status-tab active" data-tab="pending">
            ⏳ 待處理
            <span class="status-count" style="background:#ffbf00;">
                @Model.Pending.Count
            </span>
        </button>

        <button type="button" class="status-tab" data-tab="tracking">
            🔄 處理中
            <span class="status-count" style="background:#0dcaf0;">
                @Model.Tracking.Count
            </span>
        </button>

        <button type="button" class="status-tab" data-tab="closed">
            ✅ 已結案
            <span class="status-count" style="background:#198754;">
                @Model.Closed.Count
            </span>
        </button>

        <button type="button" class="status-tab" data-tab="rejected">
            ❌ 已退回
            <span class="status-count" style="background:#dc3545;">
                @Model.Rejected.Count
            </span>
        </button>

    </div>

    <div class="tab-panel active" id="pending">
        @if (Model.Pending.Any())
        {
            foreach (var item in Model.Pending)
            {
                var form = item.Main;
                var id = GetId(form);
                var number = GetText(form, "FormNumber", "ChangeNumber", "VulnerabilityNumber", "TicketNo", "No", "Code");
                if (string.IsNullOrWhiteSpace(number)) number = "CHG-" + id;

                var applicant = GetText(form, "AssignedTo", "Applicant", "RequesterName", "CreatedBy", "UserName");
                var department = GetText(form, "Department", "Team", "Dept");
                var createdAt = GetDate(form, "CreatedAt", "CreateTime", "CreatedDate");
                var summary = GetText(form, "Summary", "Title", "Description", "ChangeSummary", "Content");
                var type = GetText(form, "Type", "ChangeType", "Category");
                var expectedDate = GetDate(form, "ExpectedDate", "ScheduledAt", "ScheduledDate", "PlanDate");
                var risk = GetText(form, "RiskLevel", "Severity", "Risk", "SeverityLevel");
                var impact = GetText(form, "ImpactLevel", "Impact", "Influence");
                var dependency = GetText(form, "DependencyType", "Dependency", "DependencyLevel");

                <div class="review-item">
                    <div class="review-id">@number</div>

                    <div class="review-meta">
                        👤 申請人：@(string.IsNullOrWhiteSpace(applicant) ? "未填寫" : applicant)
                        ｜ 部門：@(string.IsNullOrWhiteSpace(department) ? "未填寫" : department)
                        ｜ 建立：@(string.IsNullOrWhiteSpace(createdAt) ? "未填寫" : createdAt)
                    </div>

                    <div class="review-summary">
                        📌 摘要：@(string.IsNullOrWhiteSpace(summary) ? "未填寫" : summary)
                    </div>

                    <div class="review-info-row">
                        <div class="review-info-item">
                            🏷️ 類型：
                            <span class="badge-soft badge-green">
                                @(string.IsNullOrWhiteSpace(type) ? "未填寫" : type)
                            </span>
                        </div>

                        <div class="review-info-item">
                            📅 預計實施：
                            @(string.IsNullOrWhiteSpace(expectedDate) ? "未填寫" : expectedDate)
                        </div>

                        <div class="review-info-item">
                            🛡️ 風險：
                            <span class="badge-soft badge-yellow">
                                @(string.IsNullOrWhiteSpace(risk) ? "未填寫" : risk)
                            </span>
                        </div>

                        <div class="review-info-item">
                            💥 影響：@(string.IsNullOrWhiteSpace(impact) ? "未填寫" : impact)
                        </div>

                        <div class="review-info-item">
                            🔗 依賴：@(string.IsNullOrWhiteSpace(dependency) ? "未填寫" : dependency)
                        </div>
                    </div>

                    <a class="detail-link" href="/Vulnerabilities/Details?id=@id">
                        查看完整內容 >
                    </a>

                    <div class="review-actions">
                        <button class="btn-review btn-approve"
                                data-bs-toggle="modal"
                                data-bs-target="#approveModal"
                                data-id="@id"
                                data-title="@number">
                            初步核准
                        </button>

                        <button class="btn-review btn-reject"
                                data-bs-toggle="modal"
                                data-bs-target="#rejectModal"
                                data-id="@id"
                                data-title="@number">
                            退回
                        </button>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="empty-box">目前沒有待處理的變更單。</div>
        }
    </div>

    <div class="tab-panel" id="tracking">
        @if (Model.Tracking.Any())
        {
            foreach (var item in Model.Tracking)
            {
                var form = item.Main;
                var id = GetId(form);
                var number = GetText(form, "FormNumber", "ChangeNumber", "VulnerabilityNumber", "TicketNo", "No", "Code");
                if (string.IsNullOrWhiteSpace(number)) number = "CHG-" + id;

                <div class="review-item">
                    <div class="review-id">@number</div>
                    <div class="review-summary">📌 處理中表單</div>
                    <a class="detail-link" href="/Vulnerabilities/Details?id=@id">查看完整內容 ></a>
                </div>
            }
        }
        else
        {
            <div class="empty-box">目前沒有處理中的變更單。</div>
        }
    </div>

    <div class="tab-panel" id="closed">
        @if (Model.Closed.Any())
        {
            foreach (var item in Model.Closed)
            {
                var form = item.Main;
                var id = GetId(form);
                var number = GetText(form, "FormNumber", "ChangeNumber", "VulnerabilityNumber", "TicketNo", "No", "Code");
                if (string.IsNullOrWhiteSpace(number)) number = "CHG-" + id;

                <div class="review-item">
                    <div class="review-id">@number</div>
                    <div class="review-summary">✅ 已結案表單</div>
                    <a class="detail-link" href="/Vulnerabilities/Details?id=@id">查看完整內容 ></a>
                </div>
            }
        }
        else
        {
            <div class="empty-box">目前沒有已結案的變更單。</div>
        }
    </div>

    <div class="tab-panel" id="rejected">
        @if (Model.Rejected.Any())
        {
            foreach (var item in Model.Rejected)
            {
                var form = item.Main;
                var id = GetId(form);
                var number = GetText(form, "FormNumber", "ChangeNumber", "VulnerabilityNumber", "TicketNo", "No", "Code");
                if (string.IsNullOrWhiteSpace(number)) number = "CHG-" + id;

                <div class="review-item">
                    <div class="review-id">@number</div>
                    <div class="review-summary">
                        ❌ 已退回表單
                        @if (!string.IsNullOrWhiteSpace(item.LatestRejectReason))
                        {
                            <span>｜原因：@item.LatestRejectReason</span>
                        }
                    </div>
                    <a class="detail-link" href="/Vulnerabilities/Details?id=@id">查看完整內容 ></a>
                </div>
            }
        }
        else
        {
            <div class="empty-box">目前沒有已退回的變更單。</div>
        }
    </div>

</div>

