@page
@model Dr.meow.Pages.Vulnerabilities.CreateModel

@{
    ViewData["Title"] = "新增變更申請單";
}

<div class="container mt-4">
    <div class="card shadow-lg">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">新增變更單申請</h4>
        </div>
        <div class="card-body">

            <form method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <h5 class="mt-3 text-primary">基本資料</h5>
                <hr class="mt-0" />
                <div class="row mb-3">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label asp-for="Vulnerability.Title" class="control-label fw-bold">1. 系統/表單類別 (對應Title)</label>
                            <input asp-for="Vulnerability.Title" class="form-control" placeholder="例如：EIP / DevOps / Dr.meow 系統" />
                            <span asp-validation-for="Vulnerability.Title" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label asp-for="Vulnerability.AssignedTo" class="control-label fw-bold">2. 單號/指派對象 (對應AssignedTo)</label>
                            <input asp-for="Vulnerability.AssignedTo" class="form-control" placeholder="例如：CHG2023001 或 申請人" />
                            <span asp-validation-for="Vulnerability.AssignedTo" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <h5 class="mt-4 text-primary">變更內容</h5>
                <hr class="mt-0" />
                <div class="row mb-3">
                    <div class="col-md-12">
                        <div class="form-group">
                            <label asp-for="Vulnerability.Description" class="control-label fw-bold">3. 變更/影響內容 (Description)</label>
                            <textarea asp-for="Vulnerability.Description" class="form-control" rows="4" placeholder="請詳細說明變更內容或影響範圍與目的。"></textarea>
                            <span asp-validation-for="Vulnerability.Description" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="control-label fw-bold mb-2">4. 變更類型 / 狀態 (Status)</label>
                            <div>
                                <div class="form-check form-check-inline">
                                    <input type="radio" asp-for="Vulnerability.Status" value="標準/獨立" id="statusStandard" class="form-check-input" />
                                    <label class="form-check-label" for="statusStandard">標準 /獨立</label>
                                </div>
                                <div class="form-check form-check-inline">
                                    <input type="radio" asp-for="Vulnerability.Status" value="緊急" id="statusEmergency" class="form-check-input" />
                                    <label class="form-check-label" for="statusEmergency">緊急</label>
                                </div>
                                <div class="form-check form-check-inline">
                                    <input type="radio" asp-for="Vulnerability.Status" value="例行" id="statusRoutine" class="form-check-input" />
                                    <label class="form-check-label" for="statusRoutine">例行</label>
                                </div>
                            </div>
                            <span asp-validation-for="Vulnerability.Status" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="control-label fw-bold mb-2">5. 影響與風險評估 (Severity)</label>
                            <div>
                                <div class="form-check form-check-inline">
                                    <input type="radio" asp-for="Vulnerability.Severity" value="低" id="severityLow" class="form-check-input" />
                                    <label class="form-check-label" for="severityLow">低風險</label>
                                </div>
                                <div class="form-check form-check-inline">
                                    <input type="radio" asp-for="Vulnerability.Severity" value="中" id="severityMedium" class="form-check-input" />
                                    <label class="form-check-label" for="severityMedium">中風險</label>
                                </div>
                                <div class="form-check form-check-inline">
                                    <input type="radio" asp-for="Vulnerability.Severity" value="高" id="severityHigh" class="form-check-input" />
                                    <label class="form-check-label" for="severityHigh">高風險</label>
                                </div>
                            </div>
                            <span asp-validation-for="Vulnerability.Severity" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <h5 class="mt-4 text-primary">實施與復原計畫</h5>
                <hr class="mt-0" />
                <div class="row mb-3">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label asp-for="Vulnerability.FoundDate" class="control-label fw-bold">6. 預計實施日期 (FoundDate)</label>
                            <input asp-for="Vulnerability.FoundDate" class="form-control" type="date" />
                            <span asp-validation-for="Vulnerability.FoundDate" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="control-label fw-bold mb-2">7. 測試與復原確認 (僅供勾選)</label>
                            <div>
                                <div class="form-check">
                                  
                                    <input class="form-check-input" type="checkbox" checked id="testPlan">
                                    <label class="form-check-label" for="testPlan">測試計畫: 已規劃</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" checked id="recoveryPlan">
                                    <label class="form-check-label" for="recoveryPlan">復原計畫: 已規劃</label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="form-group mt-4">
                    <input type="submit" value="新增表單 (Create)" class="btn btn-success btn-lg shadow" />
                    <a asp-page="Index" class="btn btn-secondary btn-lg ms-2">返回清單</a>
                </div>
            </form>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}