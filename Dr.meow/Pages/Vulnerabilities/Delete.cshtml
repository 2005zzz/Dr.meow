@page
@model Dr.meow.Pages.Vulnerabilities.DeleteModel

@{
    ViewData["Title"] = "刪除申請單確認";
}

<style>
    .vuln-delete-page .card {
        border-radius: 22px;
        background: rgba(255,255,255,0.95);
        border: 1px solid rgba(255,255,255,0.9);
        box-shadow: 0 18px 40px rgba(47,110,100,0.18);
        overflow: hidden;
    }

    .vuln-delete-page .delete-header {
        background: linear-gradient(135deg,#8fdacb,#64bba8);
        color: #ffffff;
        padding: 16px 24px;
        border-bottom: 1px solid rgba(255,255,255,0.6);
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .vuln-delete-page .delete-header-icon {
        width: 32px;
        height: 32px;
        border-radius: 999px;
        background: rgba(255,255,255,0.16);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.2rem;
    }

    .vuln-delete-page .delete-header-title {
        font-size: 1.3rem;
        font-weight: 700;
        letter-spacing: .03em;
    }

    .vuln-delete-page .card-body {
        padding: 22px 26px 20px;
    }

    .vuln-delete-page .alert-warning {
        border-radius: 14px;
        border-color: #ffe3cf;
        background-color: #fff8f1;
        color: #8a4b20;
    }

    /* 資料列表 */
    .vuln-delete-page dl {
        margin-bottom: 0.5rem;
    }

    .vuln-delete-page dt {
        font-weight: 600;
        color: #425b58;
        margin-top: 0.35rem;
    }

    .vuln-delete-page dd {
        margin-bottom: 0.35rem;
    }

    .vuln-delete-page .field-chip {
        display: inline-block;
        padding: 4px 10px;
        border-radius: 999px;
        font-size: 0.85rem;
        background: #f2faf8;
        border: 1px solid rgba(143,218,203,0.7);
        color: #2f6e64;
    }

    .vuln-delete-page .desc-box {
        padding: 10px 12px;
        border-radius: 12px;
        background: #f8fbfb;
        border: 1px solid rgba(143,218,203,0.4);
        min-height: 48px;
    }

    /* 按鈕區 */
    .vuln-delete-page .btn-delete-main {
        border-radius: 999px;
        padding: 8px 26px;
        font-weight: 600;
        border: none;
        background: linear-gradient(135deg,#ff9b8b,#ff5f5f);
        color: #ffffff;
        box-shadow: 0 10px 22px rgba(200,70,60,0.35);
        transition: 0.18s ease;
    }

        .vuln-delete-page .btn-delete-main:hover {
            background: linear-gradient(135deg,#ffb0a1,#ff4747);
            transform: translateY(-1px);
            box-shadow: 0 14px 28px rgba(200,70,60,0.4);
        }

    .vuln-delete-page .btn-cancel {
        border-radius: 999px;
        padding: 8px 22px;
        font-weight: 500;
        border: 1px solid #cfd4da;
        background-color: #f7f7f8;
        color: #4c5a64;
        text-decoration: none;
        transition: 0.15s ease;
    }

        .vuln-delete-page .btn-cancel:hover {
            background-color: #eceff3;
        }
</style>

<div class="vuln-delete-page container mt-4 mb-4">
    <div class="card">
        <!-- Header -->
        <div class="delete-header">
            <div class="delete-header-icon">
                ⚠️
            </div>
            <div>
                <div class="delete-header-title">刪除申請單確認</div>
                <div class="small" style="opacity:.9;">
                    請確認下列變更／漏洞申請資訊，刪除後將無法復原。
                </div>
            </div>
        </div>
        <!-- ⭐ 1. 通知顯示區塊 (放在最前面) -->
        @if (TempData["StatusMessage"] is string statusMessage)
        {
            // 根據訊息內容判斷是成功還是錯誤，套用對應的樣式
            var alertClass = statusMessage.Contains("錯誤") || statusMessage.Contains("❌") ? "alert-danger" : "alert-success";
            <div class="alert @alertClass alert-dismissible fade show mb-4 shadow-sm" role="alert">
                <strong>變更：</strong> @Html.Raw(statusMessage)
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        <!-- Body -->
        <div class="card-body">

            @if (!Model.IsDeletedSuccess && !TempData.ContainsKey("StatusMessage"))
            {
                <div class="alert alert-warning mb-3">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    您確定要刪除這筆申請單嗎？此動作 <strong>無法復原</strong>，相關資料將從系統中移除。
                </div>
            }

            <dl class="row">
                <dt class="col-sm-3">單號 (Ticket No)</dt>
                <dd class="col-sm-9">
                    <strong class="text-dark">
                        @(string.IsNullOrEmpty(Model.Vulnerability.TicketNumber) ? $"#{Model.Vulnerability.Id}" : Model.Vulnerability.TicketNumber)
                    </strong>
                </dd>

                <dt class="col-sm-3">系統/工單類別 (Category)</dt>
                <dd class="col-sm-9">
                    @if (!string.IsNullOrEmpty(Model.Vulnerability.SystemCategory))
                    {
                        <span class="field-chip">@Model.Vulnerability.SystemCategory</span>
                    }
                    @if (!string.IsNullOrEmpty(Model.Vulnerability.TicketCategory))
                    {
                        <span class="field-chip">@Model.Vulnerability.TicketCategory</span>
                    }
                </dd>

                <dt class="col-sm-3">變更類型 (Type)</dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.Vulnerability.ChangeType)
                </dd>

                <dt class="col-sm-3">風險評估</dt>
                <dd class="col-sm-9">
                    <div>@Html.DisplayFor(model => model.Vulnerability.Severity)</div>
                </dd>

                <dt class="col-sm-3">影響與依賴</dt>
                <dd class="col-sm-9">
                    <div>影響程度：@Html.DisplayFor(model => model.Vulnerability.ImpactLevel)</div>
                    <div>依賴性：@Html.DisplayFor(model => model.Vulnerability.Dependency)</div>
                </dd>

                <dt class="col-sm-3">預計實施時間</dt>
                <dd class="col-sm-9">
                    @if (Model.Vulnerability.ScheduledTime.HasValue)
                    {
                        // 格式化顯示：2026/03/17 14:30
                        @Model.Vulnerability.ScheduledTime.Value.ToString("yyyy/MM/dd HH:mm")
                    }
                    else
                    {
                        <span class="text-muted">未設定時間</span>
                    }
                </dd>

                <dt class="col-sm-3">確認計畫</dt>
                <dd class="col-sm-9">
                    <div>測試：@Html.DisplayFor(model => model.Vulnerability.TestPlan)</div>
                    <div>回復：@Html.DisplayFor(model => model.Vulnerability.RecoveryPlan)</div>
                </dd>

                <dt class="col-sm-3">提單人 (AssignedTo)</dt>
                <dd class="col-sm-9">
                    @if (Model.Vulnerability.Requester != null)
                    {
                        <span class="text-primary fw-bold">
                            @Model.Vulnerability.Requester.UserName
                            (@Model.Vulnerability.Requester.Account)
                        </span>
                    }
                    else
                    {
                        <span class="text-muted">未知用戶 (ID: @Model.Vulnerability.RequesterId)</span>
                    }
                </dd>

                <dt class="col-sm-3">變更內容 (Description)</dt>
                <dd class="col-sm-9">
                    <div class="desc-box">
                        @Html.DisplayFor(model => model.Vulnerability.Description)
                    </div>
                </dd>
            </dl>


            @if (!Model.IsDeletedSuccess)
            {
                <form method="post" class="mt-4 d-flex gap-2">
                    <input type="hidden" asp-for="Vulnerability.Id" />

                    <button type="submit" class="btn-delete-main">
                        確定刪除
                    </button>

                    <a asp-page="/Userhome" class="btn-cancel">
                        取消
                    </a>
                </form>
            }
        </div>
    </div>
</div>