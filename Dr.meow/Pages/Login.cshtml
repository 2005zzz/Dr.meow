@page
@model Dr.meow.Pages.LoginModel

@{
    Layout = "_LoginLayout";
    ViewData["Title"] = "登入";
}

<style>
    /* Google 風格登入按鈕 */
    .btn-google {
        border-radius: 999px;
        border: 1px solid #dadce0;
        background-color: #ffffff;
        color: #3c4043;
        font-weight: 500;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 8px 16px;
        box-shadow: 0 1px 2px rgba(0,0,0,.05);
        transition: box-shadow .15s ease, background-color .15s ease;
    }

        .btn-google:hover {
            background-color: #f7f8f8;
            box-shadow: 0 1px 3px rgba(60,64,67,.3), 0 4px 8px rgba(60,64,67,.15);
        }

    .btn-google-icon {
        width: 20px;
        height: 20px;
        border-radius: 50%;
        background-color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .btn-google-icon img {
            width: 18px;
            height: 18px;
            display: block;
        }

    /* 🌿 主題色登入按鈕 */
    .btn-login-mint {
        border-radius: 999px;
        width: 100%;
        padding: 10px;
        font-size: 1.05rem;
        font-weight: 600;
        border: none;
        background: linear-gradient(135deg, #8fdacb, #64bba8);
        color: white;
        box-shadow: 0 6px 14px rgba(47,110,100,0.25);
        transition: 0.18s ease;
    }

        .btn-login-mint:hover {
            background: linear-gradient(135deg, #7bcbbd, #51a798);
            transform: translateY(-1px);
            box-shadow: 0 8px 16px rgba(47,110,100,0.28);
        }

    /* 卡片外觀 */
    .login-card {
        max-width: 450px;
        width: 100%;
        border-radius: 24px;
        overflow: hidden;
        background: rgba(255,255,255,0.95);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        border: 1px solid rgba(255,255,255,0.9);
        box-shadow: 0 18px 40px rgba(0,0,0,0.12);
    }

        .login-card .card-header {
            border-bottom: none;
            border-top-left-radius: 24px;
            border-top-right-radius: 24px;
        }

        .login-card .card-body {
            padding: 22px 36px 18px;
        }

        .login-card .card-footer {
            border-top: none;
            border-bottom-left-radius: 24px;
            border-bottom-right-radius: 24px;
            padding: 10px 20px;
        }

        .login-card .mb-3 {
            margin-bottom: 0.75rem !important;
        }

    /* 🌿 白色寬版 - 立即註冊按鈕 */
    .btn-register-secondary {
        width: 100%;
        border-radius: 999px;
        background: #ffffff;
        border: 1px solid #dde9e7;
        padding: 10px 0;
        font-weight: 600;
        font-size: 1rem;
        color: #3FAEA0;
        text-align: center;
        display: block;
        margin-top: 10px;
        text-decoration: none !important;
        box-shadow: 0 3px 12px rgba(0,0,0,.05);
        transition: .2s ease;
    }

        .btn-register-secondary:hover {
            background: #f7fdfa;
            border-color: #8fdacb;
            color: #2da192;
            transform: translateY(-2px);
            box-shadow: 0 6px 18px rgba(47,110,100,.14);
        }

        .btn-register-secondary:active {
            transform: translateY(0);
            box-shadow: 0 3px 10px rgba(47,110,100,.10);
        }
</style>

<div class="card login-card">
    <!-- 卡片 Header -->
    <div class="card-header text-center"
         style="background: linear-gradient(135deg,#7bcbbd,#3AB6A7);
                color:white;
                padding: 18px;">
        <h4 class="mb-0">登入系統</h4>
    </div>

    <!-- 卡片 Body -->
    <div class="card-body">

        <!-- 後端塞 ErrorMessage 時顯示 -->
        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger py-2 mb-3">
                @Model.ErrorMessage
            </div>
        }

        <!-- 驗證錯誤統整（ModelState） -->
        <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>

        <form method="post">
            <div class="mb-3">
                <label asp-for="Account" class="form-label">帳號</label>
                <input asp-for="Account" class="form-control" placeholder="例如：user 或 admin" />
                <span asp-validation-for="Account" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label">密碼</label>
                <input asp-for="Password" class="form-control" type="password" placeholder="預設：1234" />
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label class="form-label d-block">登入身分</label>
                <div class="form-check form-check-inline">
                    <input class="form-check-input"
                           type="radio" asp-for="Role" value="user" id="roleUser" />
                    <label class="form-check-label" for="roleUser">使用者</label>
                </div>

                <div class="form-check form-check-inline">
                    <input class="form-check-input"
                           type="radio" asp-for="Role" value="admin" id="roleAdmin" />
                    <label class="form-check-label" for="roleAdmin">管理者</label>
                </div>

                <span asp-validation-for="Role" class="text-danger small"></span>
            </div>

            <!-- 🌿 主題色登入按鈕 -->
            <button type="submit" class="btn-login-mint mb-3">
                登入
            </button>

            <!-- Google 登入：目前只是樣式，後端還沒串 -->
            <button type="button" class="btn btn-google w-100 mt-1">
                <span class="btn-google-icon">
                    <img src="https://www.gstatic.com/firebasejs/ui/2.0.0/images/auth/google.svg" alt="Google" />
                </span>
                <span>使用 Google 帳戶快速登入</span>
            </button>

            <div class="text-center mt-3">
                <div class="text-muted mb-1">還沒有帳號嗎？</div>

                <a asp-page="/Register" class="btn-register-secondary">
                    立即註冊
                </a>
            </div>

            <div class="text-end mt-2">
                <a href="javascript:void(0)" class="small text-muted">
                    忘記密碼？
                </a>
            </div>
        </form>
    </div>

    <!-- 卡片 Footer -->
    <div class="card-footer small text-center" style="line-height:1.5;">
        <span class="text-muted">🔑 測試登入帳號</span><br>
        <span class="text-secondary">使用者：</span><b>user</b> ｜
        <span class="text-secondary">密碼：</span><b>1234</b><br>
        <span class="text-secondary">管理者：</span><b>admin</b> ｜
        <span class="text-secondary">密碼：</span><b>1234</b>
    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
