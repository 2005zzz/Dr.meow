@page
@model Dr.meow.Pages.Login.ForgotPasswordModel

@{
    Layout = "_LoginLayout";
    ViewData["Title"] = "忘記密碼";
}

<style>
    .forgot-card {
        max-width: 450px;
        width: 100%;
        border-radius: 24px;
        overflow: hidden;
        background: rgba(255,255,255,0.95);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        border: 1px solid rgba(255,255,255,0.9);
        box-shadow: 0 18px 40px rgba(0,0,0,0.12);
    }

        .forgot-card .card-header {
            border-bottom: none;
            border-top-left-radius: 24px;
            border-top-right-radius: 24px;
            background: linear-gradient(135deg,#7bcbbd,#3AB6A7);
            color: white;
            padding: 18px;
        }

        .forgot-card .card-body {
            padding: 22px 36px 18px;
        }

        .forgot-card .mb-3 {
            margin-bottom: 0.75rem !important;
        }

    .btn-reset-mint {
        border-radius: 999px;
        width: 100%;
        padding: 10px;
        font-size: 1.05rem;
        font-weight: 600;
        border: none;
        background: linear-gradient(135deg, #8fdacb, #64bba8);
        color: white;
        box-shadow: 0 6px 14px rgba(47,110,100,0.25);
        transition: 0.18s ease;
    }

        .btn-reset-mint:hover {
            background: linear-gradient(135deg, #7bcbbd, #51a798);
            transform: translateY(-1px);
            box-shadow: 0 8px 16px rgba(47,110,100,0.28);
        }

    .btn-back-login {
        width: 100%;
        border-radius: 999px;
        background: #ffffff;
        border: 1px solid #dde9e7;
        padding: 10px 0;
        font-weight: 600;
        font-size: 1rem;
        color: #3FAEA0;
        text-align: center;
        display: block;
        margin-top: 10px;
        text-decoration: none !important;
        box-shadow: 0 3px 12px rgba(0,0,0,.05);
        transition: .2s ease;
    }

        .btn-back-login:hover {
            background: #f7fdfa;
            border-color: #8fdacb;
            color: #2da192;
            transform: translateY(-2px);
            box-shadow: 0 6px 18px rgba(47,110,100,.14);
        }
</style>

<div class="card forgot-card">

    <div class="card-header text-center">
        <h4 class="mb-0">忘記密碼</h4>
    </div>

    <div class="card-body">

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger py-2 mb-3">
                @Model.ErrorMessage
            </div>
        }

        @if (!string.IsNullOrEmpty(Model.SuccessMessage))
        {
            <div class="alert alert-success py-2 mb-3">
                @Model.SuccessMessage
            </div>
        }

        <form method="post">

            <div class="mb-3">
                <label asp-for="Input.Account" class="form-label">帳號</label>
                <input asp-for="Input.Account"
                       class="form-control"
                       placeholder="請輸入帳號" />
            </div>

            <div class="mb-3">
                <label asp-for="Input.Email" class="form-label">Email</label>
                <input asp-for="Input.Email"
                       class="form-control"
                       placeholder="請輸入註冊 Email" />
            </div>

            <div class="mb-3">
                <label asp-for="Input.NewPassword" class="form-label">新密碼</label>
                <input asp-for="Input.NewPassword"
                       type="password"
                       class="form-control"
                       placeholder="請輸入新密碼" />
            </div>

            <div class="mb-3">
                <label asp-for="Input.ConfirmPassword" class="form-label">確認新密碼</label>
                <input asp-for="Input.ConfirmPassword"
                       type="password"
                       class="form-control"
                       placeholder="請再次輸入新密碼" />
            </div>

            <button type="submit" class="btn-reset-mint mb-3">
                重設密碼
            </button>

            <a asp-page="/Login/Login" class="btn-back-login">
                返回登入
            </a>

        </form>

    </div>
</div>