@page "/AdminHome"
@model Dr.meow.Pages.AdminHomeModel

@{
    ViewData["Title"] = "管理者後台";
}
<style>
    /* ✅ 讓左側選單卡片跟使用者頁一樣能浮出子選單 */
    .app-sidebar.card {
        border-radius: 22px;
        border: none;
        box-shadow: 0 10px 28px rgba(0, 0, 0, 0.06);
        position: relative;
        z-index: 30;
    }

    .app-sidebar {
        border-radius: 22px;
        overflow: visible; /* ✅ 重要：讓子選單可以浮出卡片外 */
    }

        .app-sidebar .list-group-item {
            border: none;
            background-color: #ffffff;
            padding: 0.8rem 1.1rem;
            transition: transform 0.18s ease, box-shadow 0.18s ease, background-color 0.18s ease, color 0.15s ease;
            position: relative;
        }

            .app-sidebar .list-group-item.text-uppercase {
                background-color: transparent;
                font-size: 0.78rem;
                letter-spacing: 0.08em;
                color: #999;
                padding: 0.75rem 1.1rem;
            }

        .app-sidebar .list-group-item-action:hover {
            transform: translateY(-2px);
            background-color: #e9f9f5;
            box-shadow: 0 6px 14px rgba(0, 0, 0, 0.08);
            cursor: pointer;
        }

        .app-sidebar .list-group-item.text-danger {
            color: #e45b5b;
            font-weight: 500;
        }

            .app-sidebar .list-group-item.text-danger:hover {
                background-color: #ffecec;
                box-shadow: 0 6px 14px rgba(228, 91, 91, 0.16);
                transform: translateY(-2px);
            }

    /* ✅ Hover 子選單：完全照使用者頁 */
    .submenu-wrapper {
        position: relative;
    }

    .submenu-toggle {
        user-select: none;
    }

    .submenu {
        position: absolute;
        top: 0;
        left: 100%;
        width: 180px;
        background: #ffffff;
        border-radius: 14px;
        box-shadow: 0 12px 28px rgba(0,0,0,.12);
        opacity: 0;
        visibility: hidden;
        transform: translateX(8px);
        transition: all .18s ease;
        z-index: 50;
        overflow: hidden;
    }

        .submenu a {
            display: block;
            padding: 0.75rem 1rem;
            color: #333;
            text-decoration: none;
            font-size: 0.9rem;
            transition: background .15s ease;
            background: #fff;
        }

            .submenu a:hover {
                background-color: #e9f9f5;
            }

    .submenu-wrapper:hover .submenu {
        opacity: 1;
        visibility: visible;
        transform: translateX(0);
    }

    aside.col-12.col-lg-3 {
        position: relative;
        z-index: 99999;
    }

    .submenu {
        z-index: 100000;
    }

    .row.g-3,
    .col-12.col-lg-9,
    .card {
        overflow: visible;
    }

</style>

<div class="row g-3">

    <!-- 左側選單 -->
    <aside class="col-12 col-lg-3">
        <div class="card shadow-sm">
            <div class="list-group list-group-flush app-sidebar">

                <div class="list-group-item text-secondary small text-uppercase">
                    管理功能
                    <span class="float-end text-muted small">
                        @Model.Account（管理者）
                    </span>
                </div>

                <!-- ⭐ 改為 AJAX 模式切換 -->
                <!-- ✅ 新增表單：Hover 子選單（不跳頁） -->
                <div class="submenu-wrapper">
                    <div class="list-group-item list-group-item-action submenu-toggle">
                        表單簽核管理 ▸
                    </div>

                    <div class="submenu">
                        <a href="#" onclick="loadAdminContent('/Forms/Management'); return false;">
                            📝 變更單
                        </a>

                        <a href="#" onclick="loadAdminContent('/Forms/Management'); return false;">
                            📄 需求單
                        </a>
                    </div>
                </div>

                <a class="list-group-item list-group-item-action app-admin"
                   data-mode="reports"
                   asp-page="/Vulnerabilities/Index">
                    <!-- 【重點修改】新增 asp-page 屬性，指向根目錄下的 Index 頁面 -->
                    列表清單
                </a>

                <a class="list-group-item list-group-item-action text-danger" asp-page="/Login">
                    登出
                </a>
            </div>
        </div>
    </aside>

    <!-- 右側主區 -->
    <section class="col-12 col-lg-9">
        <div class="card shadow-sm">
            <div class="card-header bg-white">
                <h5 class="mb-0">Dr.Meow 管理者後台</h5>
            </div>

            <div class="card-body">

                <!-- 提示區 -->
                <div id="noteBox" class="alert alert-info py-2 mb-3">
                    您目前以「管理者」登入，可檢視並管理所有使用者送出的變更／漏洞表單。
                </div>

                <!-- ⭐ 右側內容區：會被 AJAX 替換 -->
                <div id="adminContent">
                    <p class="text-muted">
                        左側選單可切換管理功能（例如：表單列表 / 報表分析）。
                    </p>
                </div>

            </div>
        </div>
    </section>
</div>

@section Scripts {
    <script>
        const adminContent = document.getElementById("adminContent");
        const noteBox = document.getElementById("noteBox");

        // ⭐ 點擊左側管理功能
        document.querySelectorAll(".app-admin").forEach(btn => {
            btn.addEventListener("click", () => {
                const mode = btn.dataset.mode;

                if (mode === "management") {
                    noteBox.textContent = "已切換至「表單簽核管理」。";
                    loadAdminContent("/Forms/Management");
                }
                else if (mode === "reports") {
                    noteBox.textContent = "已切換至「列表清單」。";
                    loadAdminContent("/Vulnerability/Index"); // 之後如果有報表頁面再改
                }
            });
        });

        // ⭐ AJAX 載入後端頁面（已去 Layout）
        async function loadAdminContent(url) {
            adminContent.innerHTML = "載入中…";

            try {
                const resp = await fetch(url);

                if (!resp.ok) {
                    adminContent.innerHTML = `載入失敗 (${resp.status})`;
                    return;
                }

                const html = await resp.text();
                adminContent.innerHTML = html;
            } catch (err) {
                adminContent.innerHTML = "載入失敗，請稍後重試。";
            }
        }
    </script>
}
