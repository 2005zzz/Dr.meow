﻿page "/AdminHome"
@model Dr.meow.Pages.AdminHomeModel

@{
    ViewData["Title"] = "管理者後台";
}

<style>
    /* 左側選單卡片外觀（可跟 UserHome 一致） */
    .admin-sidebar-card {
        border-radius: 22px;
        border: none;
        box-shadow: 0 10px 28px rgba(0, 0, 0, 0.06);
    }

    .app-sidebar {
        border-radius: 22px;
        overflow: hidden;
    }

        /* 每一個選單項目共用樣式 */
        .app-sidebar .list-group-item {
            border: none;
            background-color: #ffffff;
            padding: 0.8rem 1.1rem;
            transition: transform 0.18s ease, box-shadow 0.18s ease, background-color 0.18s ease, color 0.15s ease;
        }

            /* 標題列不需要浮起效果 */
            .app-sidebar .list-group-item.text-uppercase {
                background-color: transparent;
                font-size: 0.78rem;
                letter-spacing: 0.08em;
                color: #999;
                padding: 0.75rem 1.1rem;
            }

        /* 滑鼠滑過一般選項：微浮起＋淡綠底＋柔陰影 */
        .app-sidebar .list-group-item-action:hover {
            transform: translateY(-2px);
            background-color: #e9f9f5;
            box-shadow: 0 6px 14px rgba(0, 0, 0, 0.08);
            cursor: pointer;
        }

        /* active 狀態：固定高亮色 */
        .app-sidebar .list-group-item.app-admin.active {
            background-color: #d6f6ee;
            color: #1f6e61;
            font-weight: 600;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.06);
        }

        /* 登出維持紅色，但仍有 hover 浮起效果 */
        .app-sidebar .list-group-item.text-danger {
            color: #e45b5b;
            font-weight: 500;
        }

            .app-sidebar .list-group-item.text-danger:hover {
                background-color: #ffecec;
                box-shadow: 0 6px 14px rgba(228, 91, 91, 0.16);
                transform: translateY(-2px);
            }
</style>

<div class="row g-3">

    <!-- 左側選單 -->
    <aside class="col-12 col-lg-3">
        <div class="card shadow-sm admin-sidebar-card">
            <div class="list-group list-group-flush app-sidebar">

                <div class="list-group-item text-secondary small text-uppercase">
                    管理功能
                    <span class="float-end text-muted small">
                        @Model.Account（管理者）
                    </span>
                </div>

                <!-- ⭐ 改為 AJAX 模式切換 -->
                <a class="list-group-item list-group-item-action app-admin active"
                   data-mode="management">
                    表單列表 / 管理
                </a>

                <a class="list-group-item list-group-item-action app-admin"
                   data-mode="reports">
                    報表分析
                </a>

                <a class="list-group-item list-group-item-action text-danger" asp-page="/Login">
                    登出
                </a>
            </div>
        </div>
    </aside>

    <!-- 右側主區 -->
    <section class="col-12 col-lg-9">
        <div class="card shadow-sm">
            <div class="card-header bg-white">
                <h5 class="mb-0">Dr.Meow 管理者後台</h5>
            </div>

            <div class="card-body">

                <!-- 提示區 -->
                <div id="noteBox" class="alert alert-info py-2 mb-3">
                    您目前以「管理者」登入，可檢視並管理所有使用者送出的變更／漏洞表單。
                </div>

                <!-- ⭐ 右側內容區：會被 AJAX 替換 -->
                <div id="adminContent">
                    <p class="text-muted">
                        左側選單可切換管理功能（例如：表單列表 / 報表分析）。
                    </p>
                </div>

            </div>
        </div>
    </section>
</div>

@section Scripts {
    <script>
        const adminContent = document.getElementById("adminContent");
        const noteBox = document.getElementById("noteBox");
        const adminMenus = document.querySelectorAll(".app-admin");

        // ⭐ 點擊左側管理功能
        adminMenus.forEach(btn => {
            btn.addEventListener("click", () => {
                // 切換 active 樣式
                adminMenus.forEach(x => x.classList.remove("active"));
                btn.classList.add("active");

                const mode = btn.dataset.mode;

                if (mode === "management") {
                    noteBox.textContent = "已切換至「表單列表 / 管理」。";
                    loadAdminContent("/Forms/Management");
                }
                else if (mode === "reports") {
                    noteBox.textContent = "已切換至「報表分析」。";
                    loadAdminContent("/Admin/Reports"); // 之後如果有報表頁面再改
                }
            });
        });

        // ⭐ AJAX 載入後端頁面（已去 Layout）
        async function loadAdminContent(url) {
            adminContent.innerHTML = "載入中…";

            try {
                const resp = await fetch(url);

                if (!resp.ok) {
                    adminContent.innerHTML = `載入失敗 (${resp.status})`;
                    return;
                }

                const html = await resp.text();
                adminContent.innerHTML = html;
            } catch (err) {
                adminContent.innerHTML = "載入失敗，請稍後重試。";
            }
        }
    </script>
}