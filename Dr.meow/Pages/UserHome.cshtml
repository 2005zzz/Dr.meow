                ChatSnapshot: msgsContainer?.innerHTML || ""
            };

            // 🔍 診斷 Log：妳可以在瀏覽器 F12 看到這次有沒有成功抓到所有欄位
            console.log("================ [ 傳送資料診斷 ] ================");
            console.log("🚀 送往後端的資料：", finalData);
            console.log("================================================");

            try {
                // ✅ 建議直接這樣寫，確保路徑跟妳 Swagger 看到的一模一樣
                const baseUrl = API_URL.substring(0, API_URL.lastIndexOf('/'));
                const resp = await fetch(`${baseUrl}/save-form`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(finalData)
                });

                if (resp.ok) {
                    const data = await resp.json();
                    console.log("✅ [DEBUG] 存檔成功，資料內容:", data);

                    // --- A. 關閉彈窗 ---
                    const modalEl = document.getElementById('previewModal');
                    if (document.activeElement) document.activeElement.blur();
                    const modalInstance = bootstrap.Modal.getInstance(modalEl);
                    if (modalInstance) modalInstance.hide();

                    // --- B. 執行鎖定邏輯 ---
                    const currentId = window.lastActiveBotMsgId;
                    if (currentId) {
                        const btn = document.querySelector(`#reopen-container-${currentId} button`);
                        const status = document.getElementById(`status-locked-${currentId}`);
                        if (btn) btn.classList.add('d-none');
                        if (status) status.classList.remove('d-none');
                    }

                    // --- C. 準備噴出成功訊息與「續辦引導」 ---
                    const ticketNo = data.ticketNumber || data.TicketNumber || ("REQ-" + new Date().getTime());
                    const docId = data.documentId || data.DocumentId || "0";

                    const entryHtml = `
                        <div class="alert alert-success border-0 shadow-sm mb-4 animate-fadeIn" style="border-radius: 15px; background: #F0FBF9;">
                            <div class="fw-bold mb-2 text-success"><i class="bi bi-send-check-fill"></i> 成功送出！單號：${ticketNo}</div>
                            <div class="small text-secondary mb-3">此申請案已完成對話紀錄備份。您現在可以前往查看正式單據或繼續填表。</div>

                            <button onclick="switchToFormsTab()" class="btn btn-sm btn-success w-100 fw-bold mb-3"
                                    style="border-radius: 10px; background: #3AB6A7; border: none; display: flex; align-items: center; justify-content: center; gap: 8px;">
                                🚀 前往查看正式單據
                            </button>

                            <div class="pt-3 border-top border-light">
                                <div class="small text-muted fw-bold mb-2 text-center text-primary">✨ 還需要處理其他表單嗎？</div>
                                <div class="d-flex gap-2">
                                    <button class="btn btn-sm btn-outline-primary flex-grow-1 bg-white shadow-sm" onclick="handleFormSelect('Request')">📄 填新需求單</button>
                                    <button class="btn btn-sm btn-outline-info flex-grow-1 bg-white shadow-sm" onclick="handleFormSelect('Vulnerability')">🛠️ 填新變更單</button>
                                </div>
                            </div>
                        </div>
                    `;

                    // 延遲噴出，確保 Modal 動畫跑完
                    setTimeout(() => {
                        pushBot(entryHtml);

                        // 強制捲動到底部
                        setTimeout(() => {
                            if(msgsContainer) msgsContainer.scrollTop = msgsContainer.scrollHeight;
                        }, 100);
                    }, 500);

                } else {
                    const errorText = await resp.text();
                    alert("儲存失敗：" + errorText);
                }
            } catch (e) {
                console.error("❌ [FATAL ERROR] 儲存過程出錯：", e);
            }
        };
                window.switchToFormsTab = function() {
            // 找到左側那個「查看表單」的按鈕
            const formsMenuBtn = document.querySelector('a[data-mode="forms"]');

            if (formsMenuBtn) {
                // 執行原本的選單點擊邏輯
                formsMenuBtn.click();

                // 如果妳在對話視窗內，可能需要滾動回頂部看列表
                window.scrollTo({ top: 0, behavior: 'smooth' });
            } else {
                // 備援方案：如果找不到按鈕，才進行硬跳轉
                window.location.href = '/Forms/Index';
            }
        };

        window.showSource = function (fileName, msgId) {
            const sourceList = messageSources[msgId] || [];

            if (!sourceList.length && !fileName) {
                alert('這一題沒有可用的文件來源');
                return;
            }

            let activeIndex = 0;
            if (fileName) {
                const idx = sourceList.findIndex(s =>
                    (s.title && s.title.includes(fileName)) ||
                    (s.fileName && s.fileName.includes(fileName))
                );
                if (idx >= 0) activeIndex = idx;
            }

            let currentDoc = sourceList[activeIndex];
            if (!currentDoc && fileName) currentDoc = globalSourceMap[fileName];

            if (!currentDoc) {
                alert(`找不到文件來源：${fileName || '（未指定）'}`);
                return;
            }

            const titleEl = document.getElementById("sourceTitle");
            const container = document.getElementById("sourceContent");
            let currentPageIndex = 0;

            function renderPage() {
                const pages = currentDoc.pages || [];
                const contents = currentDoc.pageContents || {};

                const pageKey = pages.length ? pages[currentPageIndex] : null;
                const text = pageKey ? (contents[pageKey] || "(沒有內容)") : "(沒有內容)";

                const docTitle = currentDoc.title || currentDoc.fileName || '未命名文件';
                const totalPages = pages.length || 1;

                titleEl.textContent = `${docTitle}（${totalPages} 頁）`;

                const controlsHtml = `
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <button class="meow-page-btn" id="btnPrevPage" ${currentPageIndex === 0 ? "disabled" : ""}>‹</button>
                        <span class="meow-page-info">第 ${currentPageIndex + 1} / ${totalPages} 頁</span>
                        <button class="meow-page-btn" id="btnNextPage" ${currentPageIndex >= totalPages - 1 ? "disabled" : ""}>›</button>
                    </div>
                `;

                container.innerHTML = `
                    ${controlsHtml}
                    <div class="p-3 bg-light border rounded font-monospace small" style="white-space: pre-wrap; line-height: 1.6;">
                        ${escapeHtml(text)}
                    </div>
                `;

                const prevBtn = document.getElementById("btnPrevPage");
                const nextBtn = document.getElementById("btnNextPage");

                prevBtn && prevBtn.addEventListener("click", () => {
                    if (currentPageIndex > 0) { currentPageIndex--; renderPage(); }
                });
                nextBtn && nextBtn.addEventListener("click", () => {
                    if (currentPageIndex < totalPages - 1) { currentPageIndex++; renderPage(); }
                });
            }

            renderPage();
            sourceOffcanvas.show();
        };

        function pushUser(t) {
            msgs.insertAdjacentHTML('beforeend', `
                <div class="msg-row msg-user-row">
                    <div class="msg msg-user">${escapeHtml(t)}</div>
                </div>`);
            scrollBottom();
        }

        function pushBot(htmlContent, isLoading = false) {
            const id = 'msg-' + Date.now();
            const content = isLoading
                ? `<span class="text-secondary"><span class="spinner-border spinner-border-sm me-2"></span>${htmlContent}</span>`
                : htmlContent;

            msgs.insertAdjacentHTML('beforeend', `
                <div class="msg-row msg-bot-row" id="${id}">
                    <div class="msg msg-bot">${content}</div>
                </div>`);
            scrollBottom();
            return id;
        }

        function replaceBotMessage(id, htmlContent) {
            const el = document.getElementById(id);
            if (el) {
                el.innerHTML = `<div class="msg msg-bot">${htmlContent}</div>`;
                scrollBottom();
            }
        }

        function scrollBottom() {
            msgs.scrollTop = msgs.scrollHeight;
        }

        function escapeHtml(s) {
            return (s || '').replace(/[&<>"']/g, m => ({
                '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
            }[m]));
        }

        function escapeJs(s) {
            return (s || '').replace(/'/g, "\\'");
        }

        function addResultCard(x, msgId) {
            const title = x.title || x.fileName || '（無標題）';

            results.insertAdjacentHTML('beforeend', `
                <div class="col">
                    <div class="card result-card h-100 shadow-sm border-0">
                        <div class="card-body d-flex flex-column">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <h6 class="card-title mb-0 text-truncate">
                                    <a href="javascript:void(0)" class="text-decoration-none"
                                       onclick="showSource('${escapeJs(title)}', '${msgId}')">
                                        📄 ${escapeHtml(title)}
                                    </a>
                                </h6>
                                <span class="badge bg-light text-dark border">
                                    Score: ${escapeHtml(x.source || 'RAG')}
                                </span>
                            </div>
                            <div class="text-muted small mb-2 text-truncate">
                                ${escapeHtml(x.snippet || '')}
                            </div>
                            <div class="d-flex gap-2 mt-auto">
                                <button class="btn btn-outline-primary btn-sm w-100"
                                        onclick="showSource('${escapeJs(title)}', '${msgId}')">
                                    查看內文
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            `);
        }

        (function () {
            const SR = window.SpeechRecognition || window.webkitSpeechRecognition;
            if (!SR) return;

            const recog = new SR();
            recog.lang = 'zh-TW';
            recog.continuous = false;
            recog.interimResults = true;

            let listening = false;

            btnVoice.addEventListener('click', () => {
                listening ? stop() : start();
            });

            function start() {
                try { recog.start(); listening = true; btnVoice.textContent = '🎙️ 辨識中…'; } catch (e) { }
            }

            function stop() {
                try { recog.stop(); listening = false; btnVoice.textContent = '🔍 語音'; } catch (e) { }
            }

            recog.onresult = (e) => {
                let final = '', interim = '';
                for (let i = e.resultIndex; i < e.results.length; i++) {
                    const text = e.results[i][0].transcript;
                    if (e.results[i].isFinal) final += text;
                    else interim += text;
                }
                input.value = (final || interim).trim();
            };

            recog.onend = () => {
                listening = false;
                btnVoice.textContent = '🔍 語音';
            };
        })();
    </script>
}
