@page
@model Dr.meow.Pages.UserHomeModel

@{
    ViewData["Title"] = "使用者顧問中心";
}

<style>
    /* ===== Sidebar 外框 ===== */
    .app-sidebar.card {
        border-radius: 22px;
        border: none;
        box-shadow: 0 10px 28px rgba(0, 0, 0, 0.06);
        position: relative;
        z-index: 20;
    }

    .app-sidebar .list-group-item {
        border: none;
        background-color: #ffffff;
        padding: 0.85rem 1.2rem;
        transition: all 0.18s ease;
        position: relative;
    }

        .app-sidebar .list-group-item.text-uppercase {
            background-color: transparent;
            font-size: 0.78rem;
            letter-spacing: 0.08em;
            color: #999;
        }

    .app-sidebar .list-group-item-action:hover {
        transform: translateY(-2px);
        background-color: #e9f9f5;
        box-shadow: 0 6px 14px rgba(0, 0, 0, 0.08);
        cursor: pointer;
    }

    .app-sidebar .active {
        background-color: #d6f6ee;
        color: #1f6e61;
        font-weight: 600;
    }

    /* ===== Hover 子選單 ===== */

    .submenu-wrapper {
        position: relative;
    }

    .submenu {
        position: absolute;
        top: 0;
        left: 100%;
        width: 180px;
        background: #ffffff;
        border-radius: 14px;
        box-shadow: 0 12px 28px rgba(0,0,0,.12);
        opacity: 0;
        visibility: hidden;
        transform: translateX(8px);
        transition: all .18s ease;
        z-index: 30;
    }

        .submenu a {
            display: block;
            padding: 0.75rem 1rem;
            text-decoration: none;
            color: #333;
            font-size: 0.9rem;
            transition: background .15s ease;
        }

            .submenu a:hover {
                background-color: #e9f9f5;
            }

    .submenu-wrapper:hover .submenu {
        opacity: 1;
        visibility: visible;
        transform: translateX(0);
    }

    .text-danger:hover {
        background-color: #ffecec;
        box-shadow: 0 6px 14px rgba(228, 91, 91, 0.16);
        transform: translateY(-2px);
    }
</style>

<div class="row g-4">

    <!-- 左側選單 -->
    <aside class="col-lg-3">
        <div class="card shadow-sm app-sidebar">
            <div class="list-group list-group-flush">

                <div class="list-group-item text-secondary small text-uppercase">
                    功能
                    <span class="float-end text-muted small">
                        @Model.Account（使用者）
                    </span>
                </div>

                <!-- RAG 顧問 -->
                <a class="list-group-item list-group-item-action active">
                    RAG 顧問
                </a>

                <!-- Hover 新增表單 -->
                <div class="submenu-wrapper">
                    <div class="list-group-item list-group-item-action">
                        新增表單 ▸
                    </div>

                    <div class="submenu">
                        <a asp-page="/Vulnerabilities/Create">
                            📝 變更單
                        </a>
                        <a asp-page="/Requests/Create">
                            📄 需求單
                        </a>
                    </div>
                </div>

                <!-- 查看表單 -->
                <a class="list-group-item list-group-item-action"
                   asp-page="/Forms/Index">
                    查看表單
                </a>

                <div class="list-group-item text-secondary small text-uppercase">
                    問答歷史
                </div>

                <!-- 登出 -->
                <a class="list-group-item list-group-item-action text-danger"
                   asp-page="/Login">
                    登出
                </a>

            </div>
        </div>
    </aside>

    <!-- 右側主區 -->
    <section class="col-lg-9">
        <div class="card shadow-sm">
            <div class="card-header bg-white">
                <h5 class="mb-0">Dr.Meow 使用者顧問中心</h5>
            </div>

            <div class="card-body">

                <div class="alert alert-info py-2">
                    您目前以「使用者」登入，可向 RAG 顧問提問，
                    並填寫變更單或需求單。
                </div>

                <div class="mt-4">
                    <p>👉 請從左側選單滑鼠移到「新增表單」選擇功能。</p>
                </div>

            </div>
        </div>
    </section>

</div>
