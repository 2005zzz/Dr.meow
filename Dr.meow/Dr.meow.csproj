<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
	</PropertyGroup>

	<ItemGroup>
		  <Compile Remove="NewFolder4\**" />
		  <Compile Remove="NewFolder5\**" />
		  <Compile Remove="NewFolder6\**" />
		  <Compile Remove="NewFolder\**" />
		  <Compile Remove="Pages\NewFolder\**" />
		  <Content Remove="NewFolder4\**" />
		  <Content Remove="NewFolder5\**" />
		  <Content Remove="NewFolder6\**" />
		  <Content Remove="NewFolder\**" />
		  <Content Remove="Pages\NewFolder\**" />
		  <EmbeddedResource Remove="NewFolder4\**" />
		  <EmbeddedResource Remove="NewFolder5\**" />
		  <EmbeddedResource Remove="NewFolder6\**" />
		  <EmbeddedResource Remove="NewFolder\**" />
		  <EmbeddedResource Remove="Pages\NewFolder\**" />
